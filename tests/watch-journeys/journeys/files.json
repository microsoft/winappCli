{
  "id": "files",
  "title": "New, renamed and deleted files (rows 16-19)",
  "app": "winui",
  "project": "App",
  "process": "TodoBench",
  "steps": [
    {
      "id": "r16-new-page-xaml-first", "row": 16, "title": "New page, XAML saved first",
      "file": "App/AboutPage.xaml", "op": "create-file",
      "text": [ "<?xml version=\"1.0\" encoding=\"utf-8\" ?>", "<Page x:Class=\"TodoBench.AboutPage\" xmlns=\"http://schemas.microsoft.com/winfx/2006/xaml/presentation\" xmlns:x=\"http://schemas.microsoft.com/winfx/2006/xaml\">", "    <TextBlock x:Name=\"AboutText\" Text=\"about-v1\" />", "</Page>" ],
      "expect": { "v1": "waiting", "today": "error" }
    },
    {
      "id": "r16-new-page-code", "row": 16, "title": "Then its code-behind, and a button that opens it",
      "edits": [
        { "file": "App/AboutPage.xaml.cs", "op": "create-file", "text": [ "using Microsoft.UI.Xaml.Controls;", "", "namespace TodoBench;", "", "public sealed partial class AboutPage : Page", "{", "    public AboutPage()", "    {", "        InitializeComponent();", "    }", "}" ] },
        { "file": "App/ContactsPage.xaml.cs", "op": "replace", "find": "        StatusText.Text = Greeting();", "text": "        StatusText.Text = Greeting();\n        Frame.Navigate(typeof(AboutPage));" }
      ],
      "expect": { "v1": "live", "today": "restart" },
      "checks": [ { "assert": "invoke", "target": "HelloButton" }, { "assert": "text-equals", "target": "AboutText", "value": "about-v1" } ]
    },
    {
      "id": "r16-new-usercontrol", "row": 16, "title": "New UserControl, both files in one save, used on the page",
      "edits": [
        { "file": "App/Badge.xaml", "op": "create-file", "text": [ "<?xml version=\"1.0\" encoding=\"utf-8\" ?>", "<UserControl x:Class=\"TodoBench.Badge\" xmlns=\"http://schemas.microsoft.com/winfx/2006/xaml/presentation\" xmlns:x=\"http://schemas.microsoft.com/winfx/2006/xaml\">", "    <TextBlock x:Name=\"BadgeText\" Text=\"badge-v1\" />", "</UserControl>" ] },
        { "file": "App/Badge.xaml.cs", "op": "create-file", "text": [ "using Microsoft.UI.Xaml.Controls;", "", "namespace TodoBench;", "", "public sealed partial class Badge : UserControl", "{", "    public Badge()", "    {", "        InitializeComponent();", "    }", "}" ] },
        { "file": "App/ContactsPage.xaml", "op": "insert-after", "find": "            <local:ContactCard x:Name=\"Card\" />", "text": "            <local:Badge x:Name=\"NewBadge\" />" }
      ],
      "expect": { "v1": "live", "today": "error" },
      "checks": [ { "assert": "text-equals", "target": "BadgeText", "value": "badge-v1" } ]
    },
    {
      "id": "r19-delete-cs-file", "row": 19, "title": "Delete a .cs file nothing uses",
      "edits": [
        { "file": "App/Unused.cs", "op": "create-file", "text": [ "namespace TodoBench;", "", "internal static class Unused", "{", "    public static int Value => 1;", "}" ] }
      ],
      "expect": { "v1": "live", "today": "restart" }
    },
    {
      "id": "r19-deleted", "row": 19, "title": "(the delete itself)",
      "file": "App/Unused.cs", "op": "delete-file",
      "expect": { "v1": "live", "today": "restart-no-reason" }
    },
    {
      "id": "r17-delete-hidden-page", "row": 17, "title": "Delete a page that isn't shown",
      "edits": [
        { "file": "App/ContactsPage.xaml.cs", "op": "replace", "find": "        Frame.Navigate(typeof(AboutPage));\n", "text": "" },
        { "file": "App/AboutPage.xaml", "op": "delete-file" },
        { "file": "App/AboutPage.xaml.cs", "op": "delete-file" }
      ],
      "expect": { "v1": "live", "today": "error" },
      "note": "E1 (ghost page); fallback: restart with a reason"
    },
    {
      "id": "r18-rename-shown-page", "row": 18, "title": "Rename the page that's on screen (both files, x:Class, the class, typeof)",
      "pending": "needs the editor-rename fixture from E1",
      "expect": { "v1": "live+note", "today": "untested" }
    }
  ]
}
