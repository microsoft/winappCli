{
  "id": "release",
  "title": "A Release build under --watch (row 66)",
  "app": "winui",
  "project": "App",
  "process": "TodoBench",
  "runArguments": [ "-c", "Release" ],
  "steps": [
    {
      "id": "r66-release-csharp", "row": 66, "title": "A C# save in a Release build",
      "file": "App/ContactsPage.xaml.cs", "op": "replace", "find": "return \"hello-v1\";", "text": "return \"hello-v2\";",
      "expect": { "v1": "restart", "today": "restart-no-reason" },
      "checks": [ { "assert": "invoke", "target": "HelloButton" }, { "assert": "text-equals", "target": "StatusText", "value": "hello-v2" } ],
      "note": "v1: every save restarts, and that's said once"
    },
    {
      "id": "r66-release-xaml", "row": 66, "title": "A XAML save in a Release build",
      "file": "App/ContactsPage.xaml", "op": "replace", "find": "Text=\"Contacts\"", "text": "Text=\"People\"",
      "expect": { "v1": "restart", "today": "not-applied" },
      "checks": [ { "assert": "text-equals", "target": "Header", "value": "People" } ]
    }
  ]
}
