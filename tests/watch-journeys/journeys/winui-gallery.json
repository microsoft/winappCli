{
  "id": "winui-gallery",
  "title": "A real app: a developer's session on WinUI Gallery's ListView page",
  "note": "Needs a WinUI Gallery checkout (microsoft/WinUI-Gallery e41d8f1) set up to build with the WinUI under test: -AppSource @{ 'winui-gallery' = '<checkout>' }",
  "app": "winui-gallery",
  "project": "WinUIGallery",
  "process": "WinUIGallery",
  "packaged": true,
  "setup": [
    { "file": "WinUIGallery/App.xaml", "op": "insert-after", "find": "<x:String x:Key=\"ControlsName\">All</x:String>", "text": "            <SolidColorBrush x:Key=\"HrAppBrush\" Color=\"#FF808080\" />" },
    { "file": "WinUIGallery/Samples/ListView/ListViewPage.xaml", "op": "replace", "find": "<TextBlock Margin=\"8,8,8,4\" Style=\"{ThemeResource BaseTextBlockStyle}\">Filter by...</TextBlock>", "text": "<TextBlock x:Name=\"HrFilterLabel\" Margin=\"8,8,8,4\" Foreground=\"{ThemeResource HrAppBrush}\" Style=\"{ThemeResource BaseTextBlockStyle}\">Filter by...</TextBlock>" }
  ],
  "before": [
    { "assert": "invoke", "target": "Collections" },
    { "assert": "exists", "target": "ItemGridView" },
    { "assert": "invoke", "target": "ListView" },
    { "assert": "exists", "target": "FilterByFirstName" },
    { "assert": "set-value", "target": "FilterByFirstName", "value": "Ka" }
  ],
  "steps": [
    {
      "id": "g01-text", "row": 1, "title": "Text on the page",
      "file": "WinUIGallery/Samples/ListView/ListViewPage.xaml", "op": "replace", "find": ">Filter by...</TextBlock>", "text": ">Filter by (hr1)...</TextBlock>",
      "expect": { "v1": "live+note", "today": "restart" },
      "checks": [ { "assert": "property-equals", "target": "HrFilterLabel", "value": "Text=Filter by (hr1)..." }, { "assert": "text-equals", "target": "FilterByFirstName", "value": "Ka" } ]
    },
    {
      "id": "g03-handler-together", "row": 6, "title": "A button and its handler in one save",
      "edits": [
        { "file": "WinUIGallery/Samples/ListView/ListViewPage.xaml.cs", "op": "insert-before", "find": "    private void AddItemToEnd()", "text": "    private int hrClicks;\n\n    private void HrCount_Click(object sender, RoutedEventArgs e)\n    {\n        HrCountText.Text = $\"clicks {++hrClicks}\";\n    }\n" },
        { "file": "WinUIGallery/Samples/ListView/ListViewPage.xaml", "op": "insert-after", "find": ">Filter by (hr1)...</TextBlock>", "text": "                    <Button x:Name=\"HrCountButton\" Margin=\"8\" Content=\"hr count\" Click=\"HrCount_Click\" />\n                    <TextBlock x:Name=\"HrCountText\" Margin=\"8\" Text=\"not clicked\" />" }
      ],
      "expect": { "v1": "live+note", "today": "restart" },
      "checks": [ { "assert": "invoke", "target": "HrCountButton" }, { "assert": "property-equals", "target": "HrCountText", "value": "Text=clicks 1" }, { "assert": "text-equals", "target": "FilterByFirstName", "value": "Ka" } ]
    },
    {
      "id": "g04-xbind-add", "row": 2, "title": "x:Bind to an element on the page",
      "file": "WinUIGallery/Samples/ListView/ListViewPage.xaml", "op": "insert-after", "find": "<TextBlock x:Name=\"HrCountText\" Margin=\"8\" Text=\"not clicked\" />", "text": "                    <TextBlock x:Name=\"HrBind\" Margin=\"8\" Text=\"{x:Bind Control2.SelectionMode, Mode=OneWay}\" />",
      "expect": { "v1": "live+note", "today": "restart" },
      "checks": [ { "assert": "property-equals", "target": "HrBind", "value": "Text=Single" } ]
    },
    {
      "id": "g06-datatemplate", "row": 10, "title": "The list's DataTemplate",
      "file": "WinUIGallery/Samples/ListView/ListViewPage.xaml", "op": "replace", "find": "                    Text=\"{x:Bind Company}\" />", "text": "                    Text=\"{x:Bind Company}\" />\n                <TextBlock Grid.Row=\"1\" Grid.Column=\"1\" Margin=\"200,0,0,6\" FontSize=\"10\" Text=\"tpl hr6\" />",
      "expect": { "v1": "live+note", "today": "restart" },
      "checks": [ { "assert": "exists", "target": "tpl hr6" } ]
    },
    {
      "id": "g08-app-resource", "row": 24, "title": "App.xaml: a brush the page uses",
      "file": "WinUIGallery/App.xaml", "op": "replace", "find": "<SolidColorBrush x:Key=\"HrAppBrush\" Color=\"#FF808080\" />", "text": "<SolidColorBrush x:Key=\"HrAppBrush\" Color=\"#FFFF8C00\" />",
      "expect": { "v1": "live+note", "today": "restart" },
      "checks": [ { "assert": "property-equals", "target": "HrFilterLabel", "value": "Foreground=#FFFF8C00" }, { "assert": "text-equals", "target": "FilterByFirstName", "value": "Ka" } ]
    },
    {
      "id": "g13-page-not-shown", "row": 13, "title": "A page that isn't shown",
      "file": "WinUIGallery/Samples/Button/ButtonPage.xaml", "op": "replace", "find": "Text=\"Another option is to explicitly wrap the Button's content\"", "text": "Text=\"Another option is to explicitly wrap the Button's content (hr13)\"",
      "expect": { "v1": "live+note", "today": "restart" }
    },
    {
      "id": "g14-broken-save", "row": 9, "title": "A value only the runtime rejects",
      "file": "WinUIGallery/Samples/ListView/ListViewPage.xaml", "op": "replace", "find": "<TextBlock x:Name=\"HrCountText\" Margin=\"8\"", "text": "<TextBlock x:Name=\"HrCountText\" Margin=\"1,2,3,4,5\"",
      "expect": { "v1": "error", "today": "restart", "reason": "Thickness|1,2,3,4,5" },
      "checks": [ { "assert": "text-equals", "target": "FilterByFirstName", "value": "Ka" }, { "assert": "exists", "target": "tpl hr6" } ]
    },
    {
      "id": "g15-fixed", "row": 9, "title": "The value is fixed",
      "file": "WinUIGallery/Samples/ListView/ListViewPage.xaml", "op": "replace", "find": "<TextBlock x:Name=\"HrCountText\" Margin=\"1,2,3,4,5\"", "text": "<TextBlock x:Name=\"HrCountText\" Margin=\"8\"",
      "expect": { "v1": "live+note", "today": "restart" },
      "checks": [ { "assert": "property-equals", "target": "HrCountText", "value": "Margin=8,8,8,8" }, { "assert": "text-equals", "target": "FilterByFirstName", "value": "Ka" } ]
    }
  ]
}
