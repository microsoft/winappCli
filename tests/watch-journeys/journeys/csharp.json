{
  "id": "csharp",
  "title": "C# in the app (rows 28-32, 37)",
  "app": "winui",
  "project": "App",
  "process": "TodoBench",
  "parity": {
    "root": "ContactsPage",
    "navigate": [ { "assert": "invoke", "target": "CountButton" }, { "assert": "invoke", "target": "HelloButton" } ],
    "probes": [ { "assert": "invoke", "target": "HelloButton" } ]
  },
  "before": [ { "assert": "invoke", "target": "CountButton" } ],
  "steps": [
    {
      "id": "r28-method-body", "row": 28, "title": "Method body",
      "file": "App/ContactsPage.xaml.cs", "op": "replace", "find": "return \"hello-v1\";", "text": "return \"hello-v2\";",
      "expect": { "v1": "live", "today": "applied" },
      "checks": [ { "assert": "invoke", "target": "HelloButton" }, { "assert": "text-equals", "target": "StatusText", "value": "hello-v2" } ],
      "parity": true
    },
    {
      "id": "r28-new-method-field-class", "row": 28, "title": "New method, field and class (in existing files)",
      "edits": [
        { "file": "App/Models.cs", "op": "insert-after", "find": "namespace TodoBench;", "text": "\ninternal static class Extras\n{\n    public static string Shout(string s) => s.ToUpperInvariant();\n}" },
        { "file": "App/ContactsPage.xaml.cs", "op": "replace", "find": "        StatusText.Text = Greeting();", "text": "        _hellos++;\n        StatusText.Text = Extras.Shout(Greeting()) + \" \" + _hellos;" },
        { "file": "App/ContactsPage.xaml.cs", "op": "insert-after", "find": "    private int _clicks;", "text": "    private int _hellos;" }
      ],
      "expect": { "v1": "live", "today": "applied" },
      "checks": [ { "assert": "invoke", "target": "HelloButton" }, { "assert": "text-equals", "target": "StatusText", "value": "HELLO-V2 1" } ]
    },
    {
      "id": "r29-code-that-ran", "row": 29, "title": "Edit code that already ran (the constructor)",
      "file": "App/ContactsPage.xaml.cs", "op": "replace", "find": "        InitializeComponent();\n    }", "text": "        InitializeComponent();\n        CountText.Text = \"from-constructor\";\n    }",
      "expect": { "v1": "live+note", "today": "applied" }
    },
    {
      "id": "r30-new-static-initializer", "row": 30, "title": "New static field with an initializer",
      "edits": [
        { "file": "App/ContactsPage.xaml.cs", "op": "insert-after", "find": "    private int _hellos;", "text": "    private static string s_prefix = \"pre:\";" },
        { "file": "App/ContactsPage.xaml.cs", "op": "replace", "find": "StatusText.Text = Extras.Shout(Greeting())", "text": "StatusText.Text = s_prefix + Extras.Shout(Greeting())" }
      ],
      "expect": { "v1": "live+note", "today": "applied" },
      "checks": [ { "assert": "invoke", "target": "HelloButton" }, { "assert": "text-contains", "target": "StatusText", "value": "HELLO-V2" } ],
      "note": "D4: the note says the field starts at its default until restart"
    },
    {
      "id": "r32-optional-parameter", "row": 32, "title": "Signature change: add an optional parameter",
      "edits": [
        { "file": "App/Models.cs", "op": "replace", "find": "Shout(string s) => s.ToUpperInvariant();", "text": "Shout(string s, string end = \"!\") => s.ToUpperInvariant() + end;" }
      ],
      "expect": { "v1": "live", "today": "restart" },
      "checks": [ { "assert": "invoke", "target": "HelloButton" }, { "assert": "text-contains", "target": "StatusText", "value": "HELLO-V2!" } ]
    },
    {
      "id": "r31-rude-unseal", "row": 31, "title": "Rude edit: unseal the page class",
      "file": "App/ContactsPage.xaml.cs", "op": "replace", "find": "public sealed partial class ContactsPage", "text": "public partial class ContactsPage",
      "expect": { "v1": "restart", "today": "restart-no-reason" },
      "checks": [ { "assert": "invoke", "target": "HelloButton" }, { "assert": "text-equals", "target": "StatusText", "value": "pre:HELLO-V2! 1" } ]
    },
    {
      "id": "r37-non-english", "row": 37, "title": "Rude-edit reason on a non-English Windows",
      "pending": "needs a non-English Windows display language",
      "expect": { "v1": "restart", "today": "untested" }
    }
  ]
}
