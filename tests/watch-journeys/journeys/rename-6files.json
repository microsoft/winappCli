    { "file": "App/Use1.cs", "op": "create-file", "text": [ "namespace TodoBench;", "", "internal static class Use1", "{", "    public static string Go() => Tagger.Tag(\"1\") + Use2.Go();", "}" ] },
    { "file": "App/Use2.cs", "op": "create-file", "text": [ "namespace TodoBench;", "", "internal static class Use2", "{", "    public static string Go() => Tagger.Tag(\"2\") + Use3.Go();", "}" ] },
    { "file": "App/Use3.cs", "op": "create-file", "text": [ "namespace TodoBench;", "", "internal static class Use3", "{", "    public static string Go() => Tagger.Tag(\"3\") + Use4.Go();", "}" ] },
