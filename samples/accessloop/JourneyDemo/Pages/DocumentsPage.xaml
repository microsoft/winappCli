<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="AccessLoop.JourneyDemo.Pages.DocumentsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AccessLoop.JourneyDemo"
    AutomationProperties.AccessibilityView="Raw"
    IsTabStop="False">
    <local:AutomationStackPanel
        AutomationProperties.AutomationId="DocumentsPageRoot"
        AutomationProperties.Name="Documents page"
        Spacing="24"
        VerticalAlignment="Top">
        <TextBlock
            AutomationProperties.AutomationId="DocumentsHeading"
            Style="{StaticResource TitleTextBlockStyle}"
            Text="Documents" />
        <TextBlock
            AutomationProperties.AutomationId="DocumentsDescription"
            Text="Enter a document title, then use Tab and Enter to save it in this demo."
            TextWrapping="Wrap" />
        <TextBox
            x:Name="DocumentTitleInput"
            AutomationProperties.AutomationId="DocumentTitleInput"
            AutomationProperties.Name="Document title"
            Header="Document title"
            Text="Untitled" />
        <StackPanel Orientation="Horizontal" Spacing="12">
            <!-- Intentional missing name: the visible label stays outside this icon-only button. -->
            <Button
                AutomationProperties.AutomationId="SaveDocumentButton"
                Click="SaveDocument_Click"
                MinWidth="44"
                MinHeight="44">
                <Path
                    AutomationProperties.AccessibilityView="Raw"
                    AutomationProperties.AutomationId="SaveDocumentIcon"
                    Width="20"
                    Height="20"
                    Data="M 3,1 L 16,1 21,6 21,21 1,21 1,1 Z M 6,1 L 6,8 16,8 16,1 M 6,21 L 6,13 16,13 16,21"
                    IsHitTestVisible="False"
                    Stretch="Uniform"
                    Stroke="{ThemeResource TextFillColorPrimaryBrush}"
                    StrokeThickness="1.5" />
            </Button>
            <TextBlock
                AutomationProperties.AutomationId="SaveDocumentLabel"
                VerticalAlignment="Center"
                Text="Save document" />
        </StackPanel>
        <TextBlock
            x:Name="SaveStatus"
            AutomationProperties.AutomationId="SaveStatus"
            AutomationProperties.LiveSetting="Polite"
            Text="Not saved yet"
            TextWrapping="Wrap" />
        <TextBlock
            AutomationProperties.AutomationId="DocumentsNotice"
            Text="Demo only. Nothing is written to disk."
            TextWrapping="Wrap" />
    </local:AutomationStackPanel>
</UserControl>
