<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="AccessLoop.StateDemo.InfoDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AccessLoop.StateDemo"
    AutomationProperties.AutomationId="InfoDialog"
    AutomationProperties.Name="Layout details"
    Background="{ThemeResource StudioSurfaceBrush}"
    BorderBrush="{ThemeResource StudioBorderBrush}"
    CornerRadius="12"
    DefaultButton="None"
    Title="Layout details">
    <StackPanel Spacing="20" Width="400">
        <TextBlock
            Style="{StaticResource SecondaryTextStyle}"
            Text="A quick summary of your workspace. Everything stays in the current preview."
            TextWrapping="Wrap" />
        <Border Background="{ThemeResource StudioAccentTintBrush}" CornerRadius="8" Padding="16">
            <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="30" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Path
                    AutomationProperties.AccessibilityView="Raw"
                    Data="M 4,1 H 18 L 25,8 V 29 H 4 Z M 17,1 V 9 H 25 M 9,15 H 20 M 9,21 H 20"
                    IsHitTestVisible="False"
                    Stroke="{ThemeResource StudioAccentBrush}"
                    StrokeThickness="1.6"
                    VerticalAlignment="Center"
                    Width="30"
                    Height="32" />
                <StackPanel Grid.Column="1" Spacing="6">
                    <TextBlock
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource StudioAccentTextBrush}"
                        Text="A clear place for your next step"
                        TextWrapping="Wrap" />
                    <TextBlock FontSize="13" Style="{StaticResource SecondaryTextStyle}" Text="Overview · Focus · Supporting notes" />
                </StackPanel>
            </Grid>
        </Border>
        <StackPanel Spacing="10">
            <StackPanel Orientation="Horizontal" Spacing="14">
                <local:AutomationButton
                    AutomationProperties.AutomationId="DialogIconButton"
                    AutomationProperties.Name="Review the detail"
                    Click="DialogIconButton_Click"
                    Padding="10"
                    TabIndex="0"
                    Width="44"
                    Height="44">
                    <Path
                        AutomationProperties.AccessibilityView="Raw"
                        Width="20"
                        Height="20"
                        Data="M 9,1 A 8,8 0 1 0 9,17 A 8,8 0 1 0 9,1 M 15,15 L 22,22"
                        IsHitTestVisible="False"
                        Stretch="Uniform"
                        Stroke="{ThemeResource TextFillColorPrimaryBrush}"
                        StrokeThickness="1.7" />
                </local:AutomationButton>
                <TextBlock FontWeight="SemiBold" Text="Review the detail" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock
                x:Name="DetailStatus"
                AutomationProperties.AutomationId="DialogDetailStatus"
                AutomationProperties.LiveSetting="Polite"
                FontSize="13"
                Margin="58,0,0,0"
                Style="{StaticResource SecondaryTextStyle}"
                Text="Nothing here changes a file or setting." />
        </StackPanel>
        <Border Background="{ThemeResource StudioDividerBrush}" Height="1" />
        <local:AutomationButton
            AutomationProperties.AutomationId="CloseInfoDialog"
            AutomationProperties.Name="Close dialog"
            Click="CloseInfoDialog_Click"
            Content="Close dialog"
            HorizontalAlignment="Right"
            MinHeight="44"
            Padding="18,10"
            Style="{StaticResource AccentButtonStyle}"
            TabIndex="1" />
    </StackPanel>
</ContentDialog>
