<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="AccessLoop.StateDemo.ScopeProbeWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AccessLoop.StateDemo"
    Title="AccessLoop scope probe">
    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" Padding="28">
        <local:AutomationStackPanel
            x:Name="ScopeRoot"
            AutomationProperties.AutomationId="ScopeProbeRoot"
            AutomationProperties.Name="Scope probe"
            Loaded="ScopeRoot_Loaded"
            Spacing="18"
            VerticalAlignment="Center">
            <TextBlock
                AutomationProperties.HeadingLevel="Level1"
                FontSize="24"
                FontWeight="SemiBold"
                Text="A separate demo window"
                TextWrapping="Wrap" />
            <TextBlock
                Style="{StaticResource SecondaryTextStyle}"
                Text="This window belongs to AccessLoop, but it is not the info dialog. Close it to return to the three views." />
            <local:AutomationButton
                AutomationProperties.AutomationId="CloseScopeProbe"
                AutomationProperties.Name="Close scope probe"
                Click="CloseScopeProbe_Click"
                Content="Close scope probe"
                HorizontalAlignment="Left"
                MinHeight="44"
                Padding="18,10" />
        </local:AutomationStackPanel>
    </Grid>
</Window>
