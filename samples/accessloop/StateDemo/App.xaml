<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="AccessLoop.StateDemo.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Light">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="StudioCanvasBrush" Color="#F3F6FB" />
                    <SolidColorBrush x:Key="StudioSurfaceBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="StudioSubtleBrush" Color="#F7F9FC" />
                    <SolidColorBrush x:Key="StudioRailBrush" Color="#EFF3FA" />
                    <SolidColorBrush x:Key="StudioBorderBrush" Color="#DDE4EF" />
                    <SolidColorBrush x:Key="StudioDividerBrush" Color="#E5EAF2" />
                    <SolidColorBrush x:Key="StudioAccentBrush" Color="#275ED7" />
                    <SolidColorBrush x:Key="StudioAccentTintBrush" Color="#EAF0FF" />
                    <SolidColorBrush x:Key="StudioAccentTextBrush" Color="#234FA6" />
                    <SolidColorBrush x:Key="StudioSecondaryTextBrush" Color="#56637A" />
                    <SolidColorBrush x:Key="StudioOnAccentBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#275ED7" />
                    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#2154C4" />
                    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#1D49AC" />
                    <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="TextOnAccentFillColorSecondaryBrush" Color="#F2F6FF" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="StudioCanvasBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="StudioSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="StudioSubtleBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="StudioRailBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="StudioBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="StudioDividerBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="StudioAccentBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="StudioAccentTintBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="StudioAccentTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="StudioSecondaryTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="StudioOnAccentBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
                    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
                    <SolidColorBrush x:Key="TextOnAccentFillColorSecondaryBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <Style x:Key="DemoCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource StudioSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource StudioBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Padding" Value="20" />
            </Style>
            <Style x:Key="PageHeadingStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="24" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="AutomationProperties.HeadingLevel" Value="Level2" />
            </Style>
            <Style x:Key="SecondaryTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Foreground" Value="{ThemeResource StudioSecondaryTextBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="SectionHeadingStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="20" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="StepLabelStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{ThemeResource StudioAccentTextBrush}" />
            </Style>
            <Style x:Key="StatusTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Foreground" Value="{ThemeResource StudioAccentTextBrush}" />
            </Style>
            <Style x:Key="PreviewIndexStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{ThemeResource StudioAccentTextBrush}" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="HorizontalAlignment" Value="Center" />
            </Style>
            <Style x:Key="EditorialNumberStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="32" />
                <Setter Property="FontWeight" Value="SemiLight" />
                <Setter Property="Foreground" Value="{ThemeResource StudioAccentTextBrush}" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
