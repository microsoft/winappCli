<Project Sdk="Microsoft.NET.Sdk">

  <!--
    A WinUI class library referenced by App. It deliberately declares NO <Platforms>, so its
    effective Platform is AnyCPU. This is the exact shape that reproduces the MrtCore PRI252
    "PRI file not found" failure when a consumer forces a global -p:Platform=<arch> together with
    -p:EnableDynamicPlatformResolution=true: EDPR negotiates this library's compile down to AnyCPU
    (bin\Debug\...) while the forced Platform keeps the app's PRI-outputs lookup at bin\<arch>\...
    Without EDPR a global Platform reaches this library too, so both sides stay consistent; winapp
    project mode conveys the arch with -r <rid> instead for projects that enable EDPR.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>winui_solution_core</RootNamespace>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.7175" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260317003" />
  </ItemGroup>

</Project>
