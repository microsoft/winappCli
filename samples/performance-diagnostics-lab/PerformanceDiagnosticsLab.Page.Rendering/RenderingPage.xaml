<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="PerformanceDiagnosticsLab.Features.Rendering.RenderingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Loaded="RenderingPage_Loaded"
    Unloaded="RenderingPage_Unloaded">
    <Grid Padding="32,24,32,32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="4">
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Rendering stress" />
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="Animate and relayout a dense visual tree for 15 seconds, then return to idle." />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,20,0,16" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button
                x:Name="StartRenderingButton"
                AutomationProperties.AutomationId="StartRenderingStressButton"
                AutomationProperties.Name="Start rendering stress"
                Click="StartRenderingButton_Click"
                Content="Start"
                Style="{StaticResource AccentButtonStyle}" />
            <Button
                x:Name="StopRenderingButton"
                Grid.Column="1"
                AutomationProperties.AutomationId="StopRenderingStressButton"
                AutomationProperties.Name="Stop rendering stress"
                Click="StopRenderingButton_Click"
                Content="Stop"
                IsEnabled="False" />
            <Button
                Grid.Column="2"
                AutomationProperties.AutomationId="ResetRenderingSceneButton"
                AutomationProperties.Name="Reset rendering scene"
                Click="ResetRenderingButton_Click"
                Content="Reset" />
            <TextBlock
                x:Name="RenderingStatus"
                Grid.Column="3"
                AutomationProperties.AutomationId="RenderingStatus"
                AutomationProperties.LiveSetting="Polite"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Text="Idle" />
        </Grid>

        <Border
            Grid.Row="2"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <Canvas
                x:Name="RenderingSurface"
                AutomationProperties.AutomationId="RenderingSurface" />
        </Border>
    </Grid>
</Page>
