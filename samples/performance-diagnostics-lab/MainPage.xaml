<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="PerformanceDiagnosticsLab.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="using:PerformanceDiagnosticsLab.ViewModels"
    mc:Ignorable="d">

    <Grid>
        <Grid
            x:Name="WorkloadsPanel"
            Padding="32,24,32,32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Spacing="4">
                <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Performance test workloads" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Trigger one deterministic workload while winapp collects and diagnoses it externally." />
            </StackPanel>

            <Border
                Grid.Row="1"
                Margin="0,20,0,0"
                Padding="16"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2">
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="UI rendering workload" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="Animate 144 XAML elements to test frame and rendering diagnostics."
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <Button
                        Grid.Column="1"
                        AutomationProperties.AutomationId="OpenRenderingWorkloadButton"
                        AutomationProperties.Name="Open UI rendering workload"
                        Click="OpenRenderingWorkloadButton_Click"
                        Content="Open rendering workload"
                        Style="{StaticResource AccentButtonStyle}" />
                </Grid>
            </Border>

            <Border
                Grid.Row="2"
                Margin="0,16"
                Padding="16"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2">
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Current workload state" />
                        <TextBlock
                            AutomationProperties.AutomationId="ScenarioStatus"
                            AutomationProperties.LiveSetting="Polite"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" />
                    </StackPanel>
                    <Button
                        Grid.Column="1"
                        AutomationProperties.AutomationId="CancelScenarioButton"
                        AutomationProperties.Name="Cancel current workload"
                        Command="{x:Bind ViewModel.CancelCommand}"
                        Content="Cancel"
                        IsEnabled="{x:Bind ViewModel.IsCancelEnabled, Mode=OneWay}" />
                </Grid>
            </Border>

            <ListView
                Grid.Row="3"
                AutomationProperties.AutomationId="ScenarioList"
                ItemsSource="{x:Bind ViewModel.Scenarios, Mode=OneWay}"
                SelectionMode="None">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,0,0,8" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="viewModels:ScenarioCardViewModel">
                        <Border
                            Padding="16"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2">
                                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind Name}" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{x:Bind Description}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Workload" />
                                    <TextBlock Text="{x:Bind WorkloadLabel}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Spacing="2">
                                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="CLI should detect" />
                                    <TextBlock Text="{x:Bind ExpectedObservation}" TextWrapping="Wrap" />
                                </StackPanel>
                                <Button
                                    Grid.Column="3"
                                    AutomationProperties.AutomationId="{x:Bind RunAutomationId}"
                                    AutomationProperties.Name="{x:Bind RunAccessibleName}"
                                    Command="{x:Bind RunCommand}"
                                    Content="Run"
                                    IsEnabled="{x:Bind IsEnabled, Mode=OneWay}"
                                    Style="{StaticResource AccentButtonStyle}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <Grid
            x:Name="RenderingPanel"
            Padding="32,20,32,32"
            Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel
                Margin="0,0,0,16"
                Orientation="Horizontal"
                Spacing="12">
                <Button
                    AutomationProperties.AutomationId="BackToWorkloadsButton"
                    AutomationProperties.Name="Back to performance workloads"
                    Click="BackToWorkloadsButton_Click"
                    Content="Back" />
                <TextBlock
                    VerticalAlignment="Center"
                    Style="{StaticResource TitleTextBlockStyle}"
                    Text="UI rendering workload" />
            </StackPanel>
            <ContentControl
                x:Name="FeatureContentHost"
                Grid.Row="1"
                AutomationProperties.AutomationId="FeatureContentHost" />
        </Grid>
    </Grid>
</Page>
