<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="PerformanceDiagnosticsLab.Features.StartupPayload.StartupPayloadPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PerformanceDiagnosticsLab.Features.StartupPayload">
    <ListView
        AutomationProperties.AutomationId="StartupPayloadItems"
        IsHitTestVisible="False"
        ItemsSource="{x:Bind Items}"
        SelectionMode="None">
        <ListView.ItemTemplate>
            <DataTemplate x:DataType="local:StartupPayloadItem">
                <Grid Padding="8" ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{x:Bind Identifier}" />
                    <TextBlock Grid.Column="1" Text="{x:Bind Name}" />
                    <TextBlock Grid.Column="2" Text="{x:Bind Category}" />
                </Grid>
            </DataTemplate>
        </ListView.ItemTemplate>
    </ListView>
</Page>
