{
  "name": "winapp-apps-benchmark",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node --expose-gc --import tsx src/start.ts",
    "results": "node --expose-gc --import tsx src/start.ts --results",
    "bench": "node --expose-gc --import tsx src/headless.ts",
    "scorecard": "tsx src/scorecard.ts",
    "test": "tsx --test src/runner/*.test.ts",
    "typecheck": "tsc --noEmit -p .",
    "doctor": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/Test-Prerequisites.ps1"
  },
  "dependencies": {
    "@github/copilot-sdk": "1.0.0-beta.12",
    "ink": "^6.0.0",
    "ink-select-input": "^6.0.0",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "react": "^19.0.0",
    "yaml": "^2.8.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.7.0"
  },
  "overrides": {
    "@github/copilot": "1.0.96"
  }
}
