<Window x:Class="Lanternfish.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid RowDefinitions="Auto,*">
    <AutoSuggestBox x:Name="SearchBox" PlaceholderText="Search mail" QueryIcon="Find"
                    Margin="12" QuerySubmitted="SearchBox_QuerySubmitted" />
    <ListView x:Name="ResultsList" Grid.Row="1" ItemsSource="{x:Bind ViewModel.Results}" />
  </Grid>
</Window>
