<Page
    x:Class="Maestro.Views.LibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls">
    <controls:ListDetailsView ItemsSource="{x:Bind ViewModel.AllSongs}">
        <controls:ListDetailsView.ContextFlyout>
            <MenuFlyout>
                <MenuFlyoutItem Text="Add new song" Command="{x:Bind ViewModel.AddNewSongCommand}" />
            </MenuFlyout>
        </controls:ListDetailsView.ContextFlyout>
    </controls:ListDetailsView>
</Page>
