{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Atlas Shell",
  "version": "0.8.0",
  "identifier": "io.northpeak.atlas",
  "build": {
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Atlas Shell",
        "width": 1100,
        "height": 760
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": ["icons/icon.ico"]
  }
}
