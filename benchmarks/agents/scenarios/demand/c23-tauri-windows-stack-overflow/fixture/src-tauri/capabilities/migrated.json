{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "migrated",
  "description": "Permissions migrated from the v1 desktop build",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "os:default",
    "dialog:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-message",
    "fs:allow-read-dir",
    "fs:allow-read-text-file",
    "fs:allow-app-write",
    "fs:allow-app-write-recursive",
    "process:default",
    "shell:default"
  ]
}
