<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style x:Key="PrimaryCommandButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
    <Setter Property="MinWidth" Value="96" />
    <Setter Property="Padding" Value="{StaticResource PrimaryCommandPadding}" />
  </Style>
  <Thickness x:Key="PrimaryCommandPadding">12,5,12,6</Thickness>
</ResourceDictionary>
