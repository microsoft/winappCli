<Page x:Class="Lanternfish.Views.InboxPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid RowDefinitions="Auto,*" Padding="16,12">
    <StackPanel Orientation="Horizontal" Spacing="4">
      <TextBlock Text="Inbox" Style="{StaticResource SubtitleTextBlockStyle}" />
      <Button Content="Sync now" Margin="20,0,0,0" />
    </StackPanel>
    <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Messages}" />
  </Grid>
</Page>
