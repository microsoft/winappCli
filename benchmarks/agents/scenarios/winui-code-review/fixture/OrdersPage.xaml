<Page x:Class="ContosoOrders.OrdersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="White">
    <StackPanel>
        <TextBlock Text="Orders" FontSize="28" Foreground="#202020" />
        <Button Click="Refresh_Click"><FontIcon Glyph="&#xE72C;" /></Button>
        <ListView ItemsSource="{Binding Orders}">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <Image Source="{Binding ThumbnailUrl}" Width="48" />
                        <TextBlock Text="{Binding Title}" />
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </StackPanel>
</Page>
