<Page x:Class="Pebblewick.Views.InvoicePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel Padding="24" Spacing="8">
    <TextBox Header="Customer" Text="{Binding CustomerName}" IsReadOnly="True" />
    <TextBox Header="Due" Text="{Binding DueDate}" IsReadOnly="True" />
    <TextBox Header="Total" Text="{Binding Totals.GrandTotal}" IsReadOnly="True" />
  </StackPanel>
</Page>
