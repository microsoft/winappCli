{
  "id": "new-winui-app",
  "description": "Create a brand-new WinUI 3 app in an empty folder.",
  "set": "dev",
  "cohort": "implicit",
  "prompt": "Create a new C# WinUI 3 desktop app called PhotoTagger in this folder and run it.",
  "configurations": [
    "winapp",
    "winui",
    "both"
  ],
  "expect": {
    "capabilities": {
