<?xml version="1.0" encoding="utf-8"?>
<!--
  Microsoft.Windows.SDK.BuildTools.WinApp.targets
  
  This file provides MSBuild targets that enable 'dotnet run' for packaged
  applications.
  
  Key targets:
  - _WinAppValidateRunSupport: Validates prerequisites for running packaged apps
  - _WinAppBuildRunArgs: Builds the CLI command arguments (shared)
  - RunPackagedApp: Runs the packaged application via the WinAppCLI
  
  Integration point:
  - Hooks into the Run target to intercept 'dotnet run' for packaged apps
-->
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <!--
    ============================================================================
    Property refinement after package resolution
    ============================================================================
  -->
  <PropertyGroup>
    <!-- 
      Detect if this is a packaged app based on WindowsPackageType.
      WindowsPackageType=None explicitly marks the project as unpackaged.
      When WindowsPackageType is absent or any value other than 'None', the app is considered packaged.
    -->

    <!--
      Detect a .NET file-based app: a single .cs run through the SDK's generated
      virtual project (dotnet run app.cs). The SDK writes FileBasedProgram and
      EntryPointFilePath into that project's FIRST PropertyGroup, emitted before
      the Sdk.props import, so both are already set by the time this file is
      evaluated. EntryPointFilePath is the full path to the .cs file.

      A file-based app has no authored manifest by design — identity is inferred
      from its #:property directives — so this property is what lets the gate
      below activate without one.
    -->
    <_WinAppFileBasedApp Condition="
        '$(FileBasedProgram)' == 'true'
        And '$(EntryPointFilePath)' != ''
        And Exists('$(EntryPointFilePath)')">true</_WinAppFileBasedApp>
    <_WinAppFileBasedApp Condition="'$(_WinAppFileBasedApp)' == ''">false</_WinAppFileBasedApp>

    <!--
      Output directory for the loose-layout AppX package.
      Defaults to AppX subfolder in the output directory.
      This is set here (in targets) because $(OutputPath) is not available in props.
    -->
    <WinAppLooseLayoutPath Condition="'$(WinAppLooseLayoutPath)' == ''">$(OutputPath)AppX\</WinAppLooseLayoutPath>
    
    <!--
      When EnableMsixTooling is true and Package.appxmanifest doesn't exist but
      appxmanifest.xml does, promote it so the MSIX SDK processes it (placeholder
      resolution, PRI generation, .appxrecipe, etc.).
    -->
    <_WinAppPromoteManifest Condition="'$(EnableMsixTooling)' == 'true' And '$(_WinAppFileBasedApp)' != 'true' And !Exists('$(MSBuildProjectDirectory)\Package.appxmanifest') And Exists('$(MSBuildProjectDirectory)\appxmanifest.xml')">true</_WinAppPromoteManifest>
    
    <!--
      Path to the AppxManifest.xml file.
      Auto-detected from output directory first, then project directory.
      Checks all supported manifest filenames: Package.appxmanifest (VS convention), AppxManifest.xml (MSBuild output),
      and appxmanifest.xml (winapp convention).
      This is set here (in targets) because $(OutputPath) is not available in props.

      Output-directory locations are checked first because frameworks like MAUI
      generate the manifest at build time based on platform / msbuild props, so
      the only manifest that exists is in $(OutputPath). Project-directory
      locations cover the standard winapp / VS conventions where the manifest
      is authored in source.

      Skipped entirely for a file-based app, which delegates ALL manifest
      resolution to the CLI. Two reasons:
        - The CLI generates Package.appxmanifest INTO the build output when the
          app has no authored manifest, and regenerates it on every run. Because
          the hand-off below runs the CLI with 'no-build' against that same
          output directory, an output-directory probe would find that generated
          file on the SECOND run and pin it as an explicit manifest, freezing a
          stale identity.
        - A file-based app deliberately ignores shared-name manifests
          (Package.appxmanifest / appxmanifest.xml in the folder), because
          several .cs files can share one directory and would otherwise silently
          run under each other's identity. It honors only <stem>.appxmanifest or
          an explicit #:property WinAppManifestPath. Probing here would break
          that rule.
      Delegating keeps 'dotnet run app.cs' and 'winapp run app.cs' resolving
      identity identically.
    -->
    <WinAppManifestPath Condition="'$(_WinAppFileBasedApp)' != 'true' And '$(WinAppManifestPath)' == '' And Exists('$(OutputPath)AppxManifest.xml')">$(OutputPath)AppxManifest.xml</WinAppManifestPath>
    <WinAppManifestPath Condition="'$(_WinAppFileBasedApp)' != 'true' And '$(WinAppManifestPath)' == '' And Exists('$(OutputPath)Package.appxmanifest')">$(OutputPath)Package.appxmanifest</WinAppManifestPath>
    <WinAppManifestPath Condition="'$(_WinAppFileBasedApp)' != 'true' And '$(WinAppManifestPath)' == '' And Exists('$(OutputPath)appxmanifest.xml')">$(OutputPath)appxmanifest.xml</WinAppManifestPath>
    <WinAppManifestPath Condition="'$(_WinAppFileBasedApp)' != 'true' And '$(WinAppManifestPath)' == '' And Exists('$(MSBuildProjectDirectory)\AppxManifest.xml')">$(MSBuildProjectDirectory)\AppxManifest.xml</WinAppManifestPath>
    <WinAppManifestPath Condition="'$(_WinAppFileBasedApp)' != 'true' And '$(WinAppManifestPath)' == '' And Exists('$(MSBuildProjectDirectory)\Package.appxmanifest')">$(MSBuildProjectDirectory)\Package.appxmanifest</WinAppManifestPath>
    <WinAppManifestPath Condition="'$(_WinAppFileBasedApp)' != 'true' And '$(WinAppManifestPath)' == '' And Exists('$(MSBuildProjectDirectory)\appxmanifest.xml')">$(MSBuildProjectDirectory)\appxmanifest.xml</WinAppManifestPath>
  </PropertyGroup>

  <!--
    ============================================================================
    Master gate: _WinAppRunSupportActive
    
    Computed once here so every target / item-group below can read a single
    property instead of repeating a long condition. This also makes it safe
    to ship these targets via buildTransitive/ — they are inert by default
    in any project that is not a packaged Windows app.
    
    Discriminators:
      - EnableWinAppRunSupport: master opt-out switch (default true).
      - WindowsPackageType != 'None': consumer hasn't explicitly opted out
        of MSIX packaging. (WindowsAppSDK convention.)
      - OutputType != 'Library': excludes class libraries. We deliberately
        do NOT require OutputType == 'WinExe' because samples/dotnet-app
        is OutputType=Exe (a packaged console app activated via execution
        alias). 'Exe' must remain supported.
      - TargetPlatformIdentifier == 'windows': in multi-targeted projects
        (e.g., MAUI net*-android;net*-ios;net*-windows10.0.19041.0), this
        target file may be evaluated for non-Windows TFMs too. The non-
        Windows TFMs must build cleanly with no winapp activity. We prefer
        the explicitly-set $(TargetPlatformIdentifier) when present and
        fall back to deriving it from $(TargetFramework).
      - A manifest exists at $(WinAppManifestPath), OR the project is a .NET
        file-based app. After the auto-detection block above runs, the manifest
        property points at the first existing manifest across all supported
        output- and project-directory locations, OR at whatever path the
        consumer set explicitly. Frameworks like MAUI generate the manifest into
        $(OutputPath) based on platform / msbuild props, so we deliberately
        accept output-dir paths here — without that, MAUI head apps consuming
        this package transitively would never have the gate activate. The other
        discriminators above (WindowsPackageType, OutputType, TPI) already
        prevent activation in projects that aren't intended to be packaged
        Windows apps, so a stale output-dir manifest from a prior build only
        matters in a project that is otherwise still a packaged Windows app —
        in which case re-activating the gate is the correct behavior.

        A file-based app (a single .cs run through the SDK's virtual project)
        has NO authored manifest by design: its identity is inferred from the
        #:property directives in the file, which is exactly what the CLI's
        single-file mode already does. Requiring a manifest here is what kept
        'dotnet run app.cs' launching the raw unpackaged .exe, so the file-based
        case is accepted instead of a manifest. Note the Windows-TFM clause
        still applies: a plain net10.0 .cs is not redirected.
    ============================================================================
  -->
  <PropertyGroup>
    <!--
      Prefer the explicitly-set $(TargetPlatformIdentifier) when present
      (some non-SDK-style projects set it directly), falling back to
      deriving it from $(TargetFramework) for standard SDK-style TFMs
      like net8.0-windows10.0.19041.0.
    -->
    <_WinAppEffectiveTargetPlatformIdentifier Condition="'$(TargetPlatformIdentifier)' != ''">$(TargetPlatformIdentifier)</_WinAppEffectiveTargetPlatformIdentifier>
    <_WinAppEffectiveTargetPlatformIdentifier Condition="'$(_WinAppEffectiveTargetPlatformIdentifier)' == ''">$([MSBuild]::GetTargetPlatformIdentifier($(TargetFramework)))</_WinAppEffectiveTargetPlatformIdentifier>
  </PropertyGroup>

  <PropertyGroup>
    <_WinAppRunSupportActive Condition="
        '$(EnableWinAppRunSupport)' == 'true'
        And '$(WindowsPackageType)' != 'None'
        And '$(OutputType)' != 'Library'
        And '$(_WinAppEffectiveTargetPlatformIdentifier)' == 'windows'
        And ('$(_WinAppFileBasedApp)' == 'true'
             Or ('$(WinAppManifestPath)' != '' And Exists('$(WinAppManifestPath)')))">true</_WinAppRunSupportActive>
    <_WinAppRunSupportActive Condition="'$(_WinAppRunSupportActive)' == ''">false</_WinAppRunSupportActive>
  </PropertyGroup>

  <!--
    When EnableMsixTooling is true and the user has appxmanifest.xml (instead of
    Package.appxmanifest), promote it to an AppxManifest item so the MSIX SDK
    processes it — placeholder resolution, PRI generation, .appxrecipe, etc.
  -->
  <ItemGroup Condition="'$(_WinAppPromoteManifest)' == 'true' And '$(_WinAppRunSupportActive)' == 'true'">
    <AppxManifest Include="$(MSBuildProjectDirectory)\appxmanifest.xml" />
  </ItemGroup>

  <!--
    ============================================================================
    Design-time build support: generated XAML code-behind
    ============================================================================
    Problem: outside Visual Studio (e.g. VS Code / C# Dev Kit), design-time XAML
    markup compilation never runs, so the language service can't see the
    generated code-behind (InitializeComponent, etc.) and reports false
    "red squiggle" diagnostics.
    https://github.com/microsoft/vscode-dotnettools/issues/1018

    Fix: on non-VS design-time builds, add the generated code-behind
    (*.g.cs / *.g.i.cs) from the intermediate output to @(Compile).

    Safeguards: excludes files that are already compiled by other means — Roslyn
    source-generator output, intermediate XAML, the SDK's AssemblyInfo /
    AssemblyAttributes / GlobalUsings files, and anything already in @(Compile) —
    so the compilation never sees a duplicate (CS0101 / CS0111 / CS0579).

    Limitation: this only re-surfaces files from a prior real build; it does not
    regenerate them, so a fresh or cleaned project still shows squiggles until it
    has been built once.

    WinUI ships this same fix as its own IncludeGeneratedXamlCompileItemsForDesignTime
    target. When the referenced WinUI version has it, that target owns the job and
    this one stands down (see _WinAppWinUIProvidesDesignTimeXamlCompileItems below).
    Detection is only an optimization, not the safety net: the Include and Exclude
    here mirror WinUI's exactly, and Exclude ends with @(Compile), so whichever of
    the two targets runs second contributes nothing regardless of import order.

    EnableWinUIDesignTimeGeneratedXamlCompileItems=false turns this target off. The
    name is WinUI's, deliberately: their 2.x servicing build gates their target on it
    too, so on that build one setting disables both. Their 3.0 build ships the target
    ungated, so there this switch only turns off the winapp fallback and the platform
    still contributes its items. Nothing here tries to suppress the platform's target.
  -->
  <PropertyGroup Condition="'$(DesignTimeBuild)' == 'true' And '$(UseWinUI)' == 'true' And '$(XamlCompilerPropsAndTargetsDirectory)' != '' And Exists('$(XamlCompilerPropsAndTargetsDirectory)Microsoft.WinUI.targets')">
    <!--
      MSBuild has no "is this target defined" test, so probe the file that ships
      the target. $(XamlCompilerPropsAndTargetsDirectory) is set by WinUI's own
      Microsoft.WinUI.props, so it resolves for both direct and transitive WinUI
      references and needs no version comparison — a servicing branch that
      cherry-picks the target is detected the same as a newer feature release.
    -->
    <_WinAppWinUITargetsText>$([System.IO.File]::ReadAllText('$(XamlCompilerPropsAndTargetsDirectory)Microsoft.WinUI.targets'))</_WinAppWinUITargetsText>
    <_WinAppWinUIProvidesDesignTimeXamlCompileItems Condition="'$(_WinAppWinUITargetsText)' != ''">$(_WinAppWinUITargetsText.Contains('IncludeGeneratedXamlCompileItemsForDesignTime'))</_WinAppWinUIProvidesDesignTimeXamlCompileItems>
    <!-- Don't keep the whole file contents alive in a property. -->
    <_WinAppWinUITargetsText />
  </PropertyGroup>

  <Target Name="_WinAppIncludeGeneratedXamlCompileItemsForDesignTime"
          BeforeTargets="CoreCompile"
          Condition="'$(DesignTimeBuild)' == 'true'
                     And '$(UseWinUI)' == 'true'
                     And '$(_WinAppRunSupportActive)' == 'true'
                     And '$(_WinAppWinUIProvidesDesignTimeXamlCompileItems)' != 'true'
                     And '$(EnableWinUIDesignTimeGeneratedXamlCompileItems)' != 'false'
                     And '$(UsingMicrosoftNETSdk)' == 'true'
                     And '$(BuildingInsideVisualStudio)' != 'true'
                     And Exists('$(IntermediateOutputPath)')">
    <PropertyGroup>
      <!--
        Exclude Roslyn source-generator output, which the generators already add to
        the compilation. Only build the glob when the path property is set;
        otherwise a bare '**\*.cs' would exclude everything.
      -->
      <_WinAppDesignTimeCompilerGeneratedExclude Condition="'$(CompilerGeneratedFilesOutputPath)' != ''">$(CompilerGeneratedFilesOutputPath)\**\*.cs;</_WinAppDesignTimeCompilerGeneratedExclude>
    </PropertyGroup>
    <ItemGroup>
      <Compile Include="$(IntermediateOutputPath)**\*.g.cs;$(IntermediateOutputPath)**\*.g.i.cs"
               Exclude="$(_WinAppDesignTimeCompilerGeneratedExclude)$(IntermediateOutputPath)generated\**;$(IntermediateOutputPath)intermediatexaml\**;$(IntermediateOutputPath)**\*.AssemblyInfo.g.cs;$(IntermediateOutputPath)**\*.AssemblyAttributes.g.cs;$(IntermediateOutputPath)**\*.GlobalUsings.g.cs;@(Compile)">
        <AutoGen>True</AutoGen>
        <Visible>false</Visible>
      </Compile>
    </ItemGroup>
  </Target>

  <!--
    Temporary: Include this for non-WinUI projects as well, to ensure appxmanifest is included 
    in the build output for the CLI to find to be able to run the app. We can remove this once we have a better solution for non-WinUI projects.
    Excluded when the manifest is promoted to AppxManifest (to avoid dual item-group conflict).
  -->
  <ItemGroup Condition="'$(UseWinUI)' != 'true' And '$(_WinAppPromoteManifest)' != 'true' And '$(_WinAppRunSupportActive)' == 'true'">
    <Content Condition="Exists('$(MSBuildProjectDirectory)\appxmanifest.xml')" Include="$(MSBuildProjectDirectory)\appxmanifest.xml">  
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!--
    ============================================================================
    _WinAppResolveManifestPath Target
    
    When appxmanifest.xml is promoted to AppxManifest, the MSIX SDK generates
    AppxManifest.xml in the output directory during build. This target re-resolves
    WinAppManifestPath to point to the generated file (which has build metadata,
    resolved placeholders, etc.) instead of the raw source file.
    ============================================================================
  -->
  <Target Name="_WinAppResolveManifestPath"
          AfterTargets="Build"
          BeforeTargets="_WinAppValidateRunSupport;_WinAppBuildRunArgs"
          Condition="'$(_WinAppRunSupportActive)' == 'true' And '$(_WinAppPromoteManifest)' == 'true'">
    <PropertyGroup Condition="Exists('$(OutputPath)AppxManifest.xml')">
      <WinAppManifestPath>$(OutputPath)AppxManifest.xml</WinAppManifestPath>
    </PropertyGroup>
    <Message Text="[WinAppRunSupport] Resolved promoted manifest to: $(WinAppManifestPath)" Importance="normal" />
  </Target>

  <!--
    ============================================================================
    _WinAppValidateRunSupport Target
    
    Validates that all prerequisites are met for running the packaged app.
    ============================================================================
  -->
  <Target Name="_WinAppValidateRunSupport"
          Condition="'$(_WinAppRunSupportActive)' == 'true'">
    <Message Condition="'$(_WinAppFileBasedApp)' != 'true'" Text="[WinAppRunSupport] Manifest: $(WinAppManifestPath)" Importance="normal" />
    <Message Condition="'$(_WinAppFileBasedApp)' == 'true'" Text="[WinAppRunSupport] File-based app: $(EntryPointFilePath) (manifest resolved by winapp)" Importance="normal" />
    <Error Condition="!Exists('$(WinAppCliPath)')"
           Text="[WinAppRunSupport] WinAppCLI tool not found at '$(WinAppCliPath)'. The NuGet package may be corrupted." />
    
    <!--
      Validate the manifest.

      The existence check applies to a file-based app too. Auto-detection above is skipped entirely
      for one, so a non-empty WinAppManifestPath there is always something the consumer set, by
      '-p:WinAppManifestPath=' or a '#:property' directive. Pointing it at a path that is not there
      is a typo worth catching here, where the message can name the resolved path, rather than
      several seconds later inside winapp.

      The "no manifest at all" error stays suppressed for a file-based app, which has none by
      design - winapp infers its identity from the #:property directives in the .cs file, or from a
      <stem>.appxmanifest next to it.
    -->
    <Error Condition="'$(WinAppManifestPath)' != '' And !Exists('$(WinAppManifestPath)')"
           Text="[WinAppRunSupport] AppxManifest not found at '$(WinAppManifestPath)'. Ensure Package.appxmanifest or appxmanifest.xml exists at the resolved manifest path, in your project directory, or in the build output directory, as applicable." />
    <Error Condition="'$(_WinAppFileBasedApp)' != 'true' And '$(WinAppManifestPath)' == ''"
           Text="[WinAppRunSupport] No AppxManifest found. Ensure Package.appxmanifest or appxmanifest.xml exists in your project or build output directory. Run 'winapp init' to generate one." />
    
    <Message Text="[WinAppRunSupport] Using CLI: $(WinAppCliPath)" Importance="normal" />
    <Message Text="[WinAppRunSupport] Loose layout path: $(WinAppLooseLayoutPath)" Importance="normal" />
  </Target>

  <!--
    ============================================================================
    _WinAppBuildRunArgs Target
    
    Builds the CLI command arguments used by both RunPackagedApp and
    _WinAppPrepareRunArguments.
    ============================================================================
  -->
  <Target Name="_WinAppBuildRunArgs"
          DependsOnTargets="_WinAppValidateRunSupport"
          Condition="'$(_WinAppRunSupportActive)' == 'true'">
    <PropertyGroup>
      <!-- Remove trailing backslash from paths to avoid escaping the closing quote -->
      <_WinAppManifestPathArg>$(WinAppManifestPath.TrimEnd('\'))</_WinAppManifestPathArg>
      <_WinAppLooseLayoutPathArg>$(WinAppLooseLayoutPath.TrimEnd('\'))</_WinAppLooseLayoutPathArg>
      <_WinAppInputFolderArg>$(OutputPath.TrimEnd('\'))</_WinAppInputFolderArg>
      <!--
        Pass only an allow-listed framework category derived from evaluated MSBuild properties.
        The CLI never receives the project path/name for telemetry. MAUI is last because it is the
        highest-level app model and may use WinUI in its Windows head.
      -->
      <_WinAppProjectFramework>other-dotnet</_WinAppProjectFramework>
      <_WinAppProjectFramework Condition="'$(UseWindowsForms)' == 'true'">winforms</_WinAppProjectFramework>
      <_WinAppProjectFramework Condition="'$(UseWPF)' == 'true'">wpf</_WinAppProjectFramework>
      <_WinAppProjectFramework Condition="'$(UseWinUI)' == 'true'">winui</_WinAppProjectFramework>
      <_WinAppProjectFramework Condition="'$(UseMaui)' == 'true'">maui</_WinAppProjectFramework>
      <!--
        Leading tokens. A .csproj hands winapp its OUTPUT FOLDER, which routes the CLI into folder
        mode: nothing is built, the existing output is packaged and launched. A file-based app can't
        use folder mode, because manifest inference from #:property directives only exists in the
        CLI's single-file mode. So it hands over the .cs file itself and reproduces folder mode's
        "run what's already built" contract with two arguments:

          'no-build'                   skips the CLI's build pass, leaving only a cheap property
                                       evaluation. dotnet already built the app.
          RuntimeIdentifier property   keeps the CLI's idea of the output folder in step with the
                                       one dotnet just wrote. The CLI injects the host RID when
                                       nothing names the property, so it would evaluate
                                       bin\debug_win-x64\ while an unqualified build wrote
                                       bin\debug\, and 'no-build' would miss the fresh output (or
                                       find a stale one from an earlier 'winapp run'). NAMING the
                                       property is what suppresses that injection, so the empty
                                       value an unqualified build produces here is correct and
                                       intentional. A build that DID set a RID writes
                                       bin\debug_&lt;rid&gt;\ instead, so the effective value is passed
                                       through rather than forced empty: forcing it empty would
                                       recreate the very mismatch this token exists to prevent.

        An explicit manifest is deliberately NOT forwarded for a file-based app; winapp owns the
        whole resolution order (explicit path, #:property WinAppManifestPath, <stem>.appxmanifest,
        generated), so 'dotnet run app.cs' and 'winapp run app.cs' register the same identity.

        Both values carry the SAME percent-escaping as the forwarded properties below. Configuration
        is the one that needs it: MSBuild does not validate it, so '-p:Configuration=Debug\' builds
        happily, and splicing that into a quoted argument would escape the closing quote and swallow
        every argument after it into the configuration name. RuntimeIdentifier is escaped alongside
        it only to keep the rule uniform; the SDK rejects a RID containing any of these characters
        long before this target runs, so that escape is a no-op for every value which gets this far.
      -->
      <_WinAppEscapedConfiguration>$(Configuration.Replace('%','%2525').Replace(';','%253B').Replace(',','%252C').Replace('&quot;','%2522').Replace('\','%255C'))</_WinAppEscapedConfiguration>
      <_WinAppEscapedRuntimeIdentifier>$(RuntimeIdentifier.Replace('%','%2525').Replace(';','%253B').Replace(',','%252C').Replace('&quot;','%2522').Replace('\','%255C'))</_WinAppEscapedRuntimeIdentifier>
      <_WinAppRunArgs Condition="'$(_WinAppFileBasedApp)' == 'true'">run "$(EntryPointFilePath)" --no-build --configuration "$(_WinAppEscapedConfiguration)" -p "RuntimeIdentifier=$(_WinAppEscapedRuntimeIdentifier)"</_WinAppRunArgs>
      <_WinAppRunArgs Condition="'$(_WinAppFileBasedApp)' != 'true'">run "$(_WinAppInputFolderArg)"</_WinAppRunArgs>
      <_WinAppRunArgs Condition="'$(_WinAppFileBasedApp)' != 'true' And '$(_WinAppManifestPathArg)' != ''">$(_WinAppRunArgs) --manifest "$(_WinAppManifestPathArg)"</_WinAppRunArgs>
    </PropertyGroup>

    <!--
      Carry the build inputs into winapp's own evaluation of the .cs file.

      winapp re-evaluates the file to locate the already-built output and plan the manifest, and
      that evaluation sees the file's own directives but not the properties the outer build was
      invoked with. Without this, 'dotnet run app.cs -p:WinAppPackageName=Contoso' builds with
      WinAppPackageName=Contoso and then registers the inferred hashed identity instead, silently
      discarding the request and disagreeing with 'winapp run app.cs -p WinAppPackageName=Contoso'.

      The set below is the CLI's own SingleFileRequestedProperties, minus three deliberate
      exclusions:

        derived outputs        TargetDir, RunCommand, RunArguments and ProjectAssetsFile are
                               computed by the SDK, not supplied by the consumer. Forcing them as
                               global properties would override the CLI's evaluation with the outer
                               build's answer instead of letting it derive its own. What IS
                               forwarded is the input each one hangs off, so the derived value
                               follows without being named: OutDir, whose resolved absolute form is
                               TargetDir, and MSBuildProjectExtensionsPath, the folder
                               ProjectAssetsFile is written into.
        RuntimeIdentifier      already carried by the leading tokens above, which pass the effective
                               value through: empty when the build set no RID, which is what
                               suppresses the CLI's host RID injection, and the RID itself when one
                               was set, so both sides resolve the same output folder either way.
                               Repeating it here would be redundant.
        WinAppRunUseExecutionAlias
                               a 'true' or 'false' is already translated into the explicit alias
                               switches below, which carry extra conditions the raw property does
                               not. Forwarding those would re-enable alias behavior the switches
                               deliberately withheld. Only an EMPTY value is forwarded, below,
                               because no switch is emitted to carry it.

      Forwarding the EFFECTIVE value is a no-op when the value came from a #:property directive
      or an adjacent Directory.Build.props, because winapp's evaluation reads those too. It only
      changes the outcome when an outer override would otherwise have been lost.

      Every value is percent-escaped on the way out, for two separate reasons. The CLI REJECTS a
      property token containing ';' or ',', because MSBuild would split it into several properties
      and smuggle one past the name-only filter that protects the architecture; a capability list
      is written 'a;b', so forwarding one raw fails the run outright. And the value is spliced into
      a quoted command-line argument, where an embedded quote ends the argument early and a
      trailing backslash (OutputPath always has one) escapes the closing quote, swallowing the rest
      of the line. Escaping '%' FIRST keeps the rest reversible: MSBuild unescapes '%XX' when it
      reads the property back, so each one round-trips to the original value. '%2525' is how this
      file spells a literal '%25'.

      The escape is spelled out per property rather than applied once over the item list, because
      the batched form has to name the value as %(Value) INSIDE a single-quoted function argument.
      An apostrophe in the value closes that argument, and MSBuild then silently emits the
      unevaluated expression text as the value. Calling the method on the property itself never
      puts the value in the expression, so 'Bob's App' survives.
    -->
    <ItemGroup Condition="'$(_WinAppFileBasedApp)' == 'true'">
      <!--
        Identity properties, forwarded even when empty. Winapp maps an empty property to "absent"
        exactly as it maps an undeclared one, so an empty value is not a lost default: it is how
        'dotnet run app.cs -p:WinAppPackageName=' clears a #:property directive. Skipping it would
        leave winapp reading the directive the outer build was told to discard.
      -->
      <_WinAppForwardedProperty Include="WinAppPackageName" Value="$(WinAppPackageName.Replace('%','%2525').Replace(';','%253B').Replace(',','%252C').Replace('&quot;','%2522').Replace('\','%255C'))" />
      <_WinAppForwardedProperty Include="WinAppDisplayName" Value="$(WinAppDisplayName.Replace('%','%2525').Replace(';','%253B').Replace(',','%252C').Replace('&quot;','%2522').Replace('\','%255C'))" />
      <_WinAppForwardedProperty Include="WinAppPublisher" Value="$(WinAppPublisher.Replace('%','%2525').Replace(';','%253B').Replace(',','%252C').Replace('&quot;','%2522').Replace('\','%255C'))" />
      <_WinAppForwardedProperty Include="WinAppVersion" Value="$(WinAppVersion.Replace('%','%2525').Replace(';','%253B').Replace(',','%252C').Replace('&quot;','%2522').Replace('\','%255C'))" />
      <_WinAppForwardedProperty Include="WinAppDescription" Value="$(WinAppDescription.Replace('%','%2525').Replace(';','%253B').Replace(',','%252C').Replace('&quot;','%2522').Replace('\','%255C'))" />
      <_WinAppForwardedProperty Include="WinAppCapabilities" Value="$(WinAppCapabilities.Replace('%','%2525').Replace(';','%253B').Replace(',','%252C').Replace('&quot;','%2522').Replace('\','%255C'))" />
      <_WinAppForwardedProperty Include="WinAppManifestPath" Value="$(WinAppManifestPath.Replace('%','%2525').Replace(';','%253B').Replace(',','%252C').Replace('&quot;','%2522').Replace('\','%255C'))" />

      <!--
        Packaging mode, forwarded even when empty, because it is the property the gate itself keys
        off. 'dotnet run app.cs -p:WindowsPackageType=' over a '#:property WindowsPackageType=None'
        activates the packaged redirect, so winapp has to see the same cleared value; skipping it
        would leave winapp reading None and treating a run the outer build already routed through
        packaging as unpackaged. An empty value is also what an ordinary packaged .cs evaluates to,
        so forwarding it changes nothing in the common case.
      -->
      <_WinAppForwardedProperty Include="WindowsPackageType" Value="$(WindowsPackageType.Replace('%','%2525').Replace(';','%253B').Replace(',','%252C').Replace('&quot;','%2522').Replace('\','%255C'))" />

      <!--
        Self-contained mode, forwarded even when empty. Unlike the build inputs below, nothing gives
        this property a default: it is absent unless the consumer asks for it, so an empty value is
        a real answer rather than a sign the outer build is broken.

        That makes a clear meaningful. 'dotnet run app.cs -p:WindowsAppSDKSelfContained=' over a
        '#:property WindowsAppSDKSelfContained=true' directive has to reach winapp, because winapp
        re-reads the directives from the .cs. Dropping the empty token would leave it generating a
        manifest that still declares the Windows App Runtime dependency for a build that no longer
        carries the runtime, and the app fails at startup with a class-not-registered error instead
        of running framework-dependent as asked.
      -->
      <_WinAppForwardedProperty Include="WindowsAppSDKSelfContained" Value="$(WindowsAppSDKSelfContained.Replace('%','%2525').Replace(';','%253B').Replace(',','%252C').Replace('&quot;','%2522').Replace('\','%255C'))" />

      <!--
        The alias preference, forwarded ONLY when it has no value. A 'true' or 'false' is already
        expressed by the switches below, which carry extra conditions the raw property does not, so
        forwarding those would re-enable alias behavior a launch switch deliberately withheld. An
        empty value has no switch to carry it, which is how a clear of a #:property directive would
        otherwise be lost.
      -->
      <_WinAppForwardedProperty Include="WinAppRunUseExecutionAlias" Value="" Condition="'$(WinAppRunUseExecutionAlias)' == ''" />

      <!--
        Build inputs, forwarded only when they have a value. These decide WHERE the CLI looks for
        the output dotnet just built and WHAT it finds there, so losing one makes the no-build
        hand-off inspect the wrong folder or the wrong file name. Version is read as the manifest
        version when WinAppVersion is absent.

        The SDK gives each of these a value, so an empty one means the consumer cleared it and the
        outer build is already broken. Forwarding that empty value would make it worse: as a global
        property it would also suppress the default inside winapp's evaluation, which would
        otherwise still resolve the name and folder the build actually used.
      -->
      <_WinAppForwardedProperty Include="AssemblyName" Value="$(AssemblyName.Replace('%','%2525').Replace(';','%253B').Replace(',','%252C').Replace('&quot;','%2522').Replace('\','%255C'))" Condition="'$(AssemblyName)' != ''" />
      <_WinAppForwardedProperty Include="OutputPath" Value="$(OutputPath.Replace('%','%2525').Replace(';','%253B').Replace(',','%252C').Replace('&quot;','%2522').Replace('\','%255C'))" Condition="'$(OutputPath)' != ''" />
      <!--
        OutDir, not just OutputPath, because OutDir is the property MSBuild actually writes the
        executable to. It DEFAULTS to OutputPath, but '-p:OutDir=.\custom-output\' moves the output
        while leaving OutputPath at bin\debug\, so forwarding OutputPath alone would send the CLI to
        a directory the build never wrote ("The build output directory does not exist", or worse, a
        stale build from an earlier run). The CLI resolves the layout from TargetDir, which is just
        the absolute form of OutDir, so naming OutDir is what steers it.

        The effective value is forwarded as-is even when relative: MSBuild resolves it against the
        project directory, which for a file-based app is the directory holding the .cs, so both
        passes resolve the same folder no matter where either was launched from.
      -->
      <_WinAppForwardedProperty Include="OutDir" Value="$(OutDir.Replace('%','%2525').Replace(';','%253B').Replace(',','%252C').Replace('&quot;','%2522').Replace('\','%255C'))" Condition="'$(OutDir)' != ''" />
      <!--
        The obj folder, for the same reason as OutDir: the CLI reads project.assets.json to discover
        which packages the build actually restored, and ProjectAssetsFile is just
        '$(MSBuildProjectExtensionsPath)project.assets.json'. Relocating the intermediate directory
        with '-p:BaseIntermediateOutputPath=custom_obj\' moves the assets file out of the SDK's
        runfile folder, so an evaluation that was told nothing would re-derive the default path and
        read a stale graph or none at all, quietly dropping the conditional Windows App SDK
        dependencies that decide provisioning and the generated manifest.

        Naming the folder rather than the file covers a relocation spelled either way, since
        MSBuildProjectExtensionsPath is what BaseIntermediateOutputPath feeds. It always evaluates
        to an absolute path, so unlike OutDir there is no relative-resolution question, and in the
        default case it is the same runfile folder the CLI's own evaluation would compute anyway.
      -->
      <_WinAppForwardedProperty Include="MSBuildProjectExtensionsPath" Value="$(MSBuildProjectExtensionsPath.Replace('%','%2525').Replace(';','%253B').Replace(',','%252C').Replace('&quot;','%2522').Replace('\','%255C'))" Condition="'$(MSBuildProjectExtensionsPath)' != ''" />
      <_WinAppForwardedProperty Include="OutputType" Value="$(OutputType.Replace('%','%2525').Replace(';','%253B').Replace(',','%252C').Replace('&quot;','%2522').Replace('\','%255C'))" Condition="'$(OutputType)' != ''" />
      <_WinAppForwardedProperty Include="TargetFramework" Value="$(TargetFramework.Replace('%','%2525').Replace(';','%253B').Replace(',','%252C').Replace('&quot;','%2522').Replace('\','%255C'))" Condition="'$(TargetFramework)' != ''" />
      <_WinAppForwardedProperty Include="Version" Value="$(Version.Replace('%','%2525').Replace(';','%253B').Replace(',','%252C').Replace('&quot;','%2522').Replace('\','%255C'))" Condition="'$(Version)' != ''" />
    </ItemGroup>

    <PropertyGroup>
      <_WinAppRunArgs Condition="'@(_WinAppForwardedProperty)' != ''">$(_WinAppRunArgs) @(_WinAppForwardedProperty->'-p "%(Identity)=%(Value)"', ' ')</_WinAppRunArgs>
    </PropertyGroup>

    <PropertyGroup>
      <_WinAppRunArgs Condition="'$(_WinAppLooseLayoutPathArg)' != ''">$(_WinAppRunArgs) --output-appx-directory "$(_WinAppLooseLayoutPathArg)"</_WinAppRunArgs>
      <_WinAppRunArgs Condition="'$(WinAppLaunchArgs)' != ''">$(_WinAppRunArgs) --args "$(WinAppLaunchArgs)"</_WinAppRunArgs>
      <!--
        Only an EXPLICIT preference is forwarded. The console default is left to winapp, which reads the
        built binary's PE subsystem and treats its own inference as a default: an alias that turns out to
        be unavailable degrades to AUMID instead of failing the run. Forwarding the inferred case here
        would spell it as an explicit request and make that same situation an error.

        WinAppRunNoLaunch and WinAppRunDetach each describe a launch an alias cannot express, and winapp
        resolves that by letting the launch switch win over a declared preference. Forwarding the
        alias-launch switch alongside them would instead hit the CLI's mutual-exclusion check and fail the
        run, so the same project would behave differently through 'dotnet run' than through 'winapp run'.
        The opt-out switch asks for the AUMID activation both of those already use, so it stays.
      -->
      <_WinAppRunArgs Condition="'$(WinAppRunUseExecutionAlias)' == 'true' and '$(WinAppRunNoLaunch)' != 'true' and '$(WinAppRunDetach)' != 'true'">$(_WinAppRunArgs) --with-alias</_WinAppRunArgs>
      <_WinAppRunArgs Condition="'$(WinAppRunUseExecutionAlias)' == 'false'">$(_WinAppRunArgs) --without-alias</_WinAppRunArgs>
      <_WinAppRunArgs Condition="'$(WinAppRunNoLaunch)' == 'true'">$(_WinAppRunArgs) --no-launch</_WinAppRunArgs>
      <_WinAppRunArgs Condition="'$(WinAppRunDebugOutput)' == 'true'">$(_WinAppRunArgs) --debug-output</_WinAppRunArgs>
      <_WinAppRunArgs Condition="'$(WinAppRunDetach)' == 'true'">$(_WinAppRunArgs) --detach</_WinAppRunArgs>
      <_WinAppRunArgs Condition="'$(WinAppRunUnregisterOnExit)' == 'true'">$(_WinAppRunArgs) --unregister-on-exit</_WinAppRunArgs>
      <_WinAppRunArgs Condition="'$(WinAppRunClean)' == 'true'">$(_WinAppRunArgs) --clean</_WinAppRunArgs>
      <_WinAppRunArgs Condition="'$(WinAppRunSymbols)' == 'true'">$(_WinAppRunArgs) --symbols</_WinAppRunArgs>
      <_WinAppRunArgs Condition="'$(WinAppRunExecutable)' != ''">$(_WinAppRunArgs) --executable "$(WinAppRunExecutable)"</_WinAppRunArgs>
      <_WinAppRunArgs>$(_WinAppRunArgs) --project-framework $(_WinAppProjectFramework)</_WinAppRunArgs>
      <_WinAppRunArgs>$(_WinAppRunArgs) --caller nuget-package</_WinAppRunArgs>
      <!--
        WinAppRunArgs is appended last so it lands after every property-derived switch,
        matching the position AdditionalOptions occupies in other toolsets. It is the
        escape hatch for options with no dedicated property, such as the verbose switch.
      -->
      <_WinAppRunArgs Condition="'$(WinAppRunArgs)' != ''">$(_WinAppRunArgs) $(WinAppRunArgs)</_WinAppRunArgs>
    </PropertyGroup>

    <!--
      Reject a line break before either transport sees it.

      Exec writes its command to a temporary .cmd file, so a CR or LF inside any forwarded value
      does not stay data: it ends that batch line and turns the remainder into SEPARATE COMMANDS.
      A WinAppDescription of "first{LF}echo pwned{LF}rem " runs the echo. MSBuild takes properties
      from the environment, so a variable of the matching name is enough - no authored target is
      needed. The dotnet run path starts RunCommand directly and so cannot execute the tail, but a
      split argument list corrupts the launch there too.

      No metadata this package forwards is meaningfully multi-line: a manifest display name,
      description, publisher or capability list is a single line by definition. So this refuses the
      build rather than silently stripping, which would register an identity the consumer did not
      ask for. The test runs on the ASSEMBLED string to cover every source at once, including paths
      and the WinAppRunArgs / WinAppLaunchArgs escape hatches.

      '%0D' and '%0A' are MSBuild's escapes for the characters themselves, so these properties hold
      one real character each. The result is kept in a boolean property rather than compared inline
      because a Condition that expands the value would break on an apostrophe, the same hazard that
      shapes the per-property escaping above.
    -->
    <PropertyGroup>
      <_WinAppCarriageReturn>%0D</_WinAppCarriageReturn>
      <_WinAppLineFeed>%0A</_WinAppLineFeed>
      <_WinAppRunArgsHaveLineBreak>$(_WinAppRunArgs.Contains('$(_WinAppCarriageReturn)'))</_WinAppRunArgsHaveLineBreak>
      <_WinAppRunArgsHaveLineBreak Condition="!$(_WinAppRunArgsHaveLineBreak)">$(_WinAppRunArgs.Contains('$(_WinAppLineFeed)'))</_WinAppRunArgsHaveLineBreak>
    </PropertyGroup>

    <Error Condition="$(_WinAppRunArgsHaveLineBreak)"
           Text="[WinAppRunSupport] A value forwarded to winapp contains a line break, which would split the launch command into separate shell commands. Remove the newline from the app metadata - check WinAppDisplayName, WinAppDescription, WinAppPublisher, WinAppPackageName, WinAppCapabilities, WinAppLaunchArgs and WinAppRunArgs, including any environment variable of the same name." />

    <!--
      The same arguments, spelled for the Exec task's transport.

      Exec writes its command to a temporary .cmd file, where cmd.exe reads '%N' as a batch
      parameter. A percent-escaped property value ('a%3Bb') would arrive as 'aBb' with the '%3'
      silently eaten, so every '%' is doubled to survive that one hop. This also covers a path
      containing a literal '%', which cmd would otherwise mangle the same way.

      dotnet run does NOT go through cmd: it starts RunCommand directly, so RunArguments keeps the
      undoubled form below. Diagnostics print the undoubled form too, since that is what winapp
      actually receives.
    -->
    <PropertyGroup>
      <_WinAppRunArgsForExec>$(_WinAppRunArgs.Replace('%','%25%25'))</_WinAppRunArgsForExec>
    </PropertyGroup>
  </Target>

  <!--
    ============================================================================
    RunPackagedApp Target
    
    The main target that runs the packaged application.
    This target:
    1. Invokes the WinAppCLI 'run' command
    2. The CLI handles debug identity registration and app launch
    ============================================================================
  -->
  <Target Name="RunPackagedApp"
          DependsOnTargets="_WinAppBuildRunArgs;_WinAppCopyContentToLooseLayout"
          Condition="'$(_WinAppRunSupportActive)' == 'true'">
    
    <Message Text="[WinAppRunSupport] Launching packaged application..." Importance="high" />
    <!--
      The arguments winapp itself receives, which is what matters when diagnosing quoting. The Exec
      below runs $(_WinAppRunArgsForExec), the same string with '%' doubled for cmd's benefit; that
      doubling is a transport detail of the batch file Exec writes, not part of the command line.
    -->
    <Message Text="[WinAppRunSupport] winapp receives: &quot;$(WinAppCliPath)&quot; $(_WinAppRunArgs)" Importance="normal" />
    
    <!-- Execute the CLI to run the packaged app -->
    <Exec Command="&quot;$(WinAppCliPath)&quot; $(_WinAppRunArgsForExec)"
          WorkingDirectory="$(MSBuildProjectDirectory)"
          IgnoreExitCode="false"
          ConsoleToMSBuild="false">
      <Output TaskParameter="ExitCode" PropertyName="_WinAppRunExitCode" />
    </Exec>
    
    <Message Condition="'$(_WinAppRunExitCode)' == '0'" 
             Text="[WinAppRunSupport] Application launched successfully" 
             Importance="high" />
    <Error Condition="'$(_WinAppRunExitCode)' != '0'"
           Text="[WinAppRunSupport] Failed to launch application (exit code: $(_WinAppRunExitCode))" />
  </Target>

  <!--
    ============================================================================
    _WinAppCopyContentToLooseLayout Target
    
    Copies Content and None items to the loose-layout AppX directory.
    
    The MSIX packaging targets (Microsoft.Windows.SDK.BuildTools.MSIX) override
    GetCopyToOutputDirectoryItemsOutputGroup to return ALL items from
    @(AllItemsFullPathWithTargetPath) — including Content items without
    CopyToOutputDirectory set. These items flow into @(PackagingOutputs) →
    @(AppxPackagePayload) and ultimately into the .appxrecipe file, which
    Visual Studio reads to deploy files from their source locations.
    
    Outside VS, the recipe mechanism doesn't apply. This target physically
    copies those Content/None items to the AppX layout folder so the
    packaged app can access them at runtime.

    Inert for a file-based app: the SDK's virtual project sets
    EnableDefaultCompileItems=false and EnableDefaultNoneItems=false, so there
    are no default Content/None items to stage, and the CLI builds the loose
    layout itself during the single-file run.
    ============================================================================
  -->
  <Target Name="_WinAppCopyContentToLooseLayout"
          Condition="'$(_WinAppRunSupportActive)' == 'true' And '$(_WinAppFileBasedApp)' != 'true'"
          DependsOnTargets="AssignTargetPaths">

    <MakeDir Directories="$(WinAppLooseLayoutPath)" />

    <!--
      Copy Content items to the AppX loose layout. ContentWithTargetPath is
      populated by AssignTargetPaths and includes ALL Content items regardless
      of CopyToOutputDirectory. Items already in the output dir are harmlessly
      skipped by SkipUnchangedFiles.
    -->
    <Copy SourceFiles="@(ContentWithTargetPath)"
          DestinationFiles="@(ContentWithTargetPath->'$(WinAppLooseLayoutPath)%(TargetPath)')"
          SkipUnchangedFiles="true"
          Condition="'@(ContentWithTargetPath)' != ''" />

    <!--
      Copy None items that have CopyToOutputDirectory set. These are typically
      loose files (config, data) that should also appear in the package. None
      items WITHOUT CopyToOutputDirectory are intentionally excluded — they are
      not runtime-relevant.
    -->
    <Copy SourceFiles="@(_NoneWithTargetPath)"
          DestinationFiles="@(_NoneWithTargetPath->'$(WinAppLooseLayoutPath)%(TargetPath)')"
          SkipUnchangedFiles="true"
          Condition="'@(_NoneWithTargetPath)' != '' And '%(_NoneWithTargetPath.CopyToOutputDirectory)' != ''" />

    <Message Text="[WinAppRunSupport] Copied content items to loose layout: $(WinAppLooseLayoutPath)"
             Importance="normal"
             Condition="'@(ContentWithTargetPath)' != ''" />
  </Target>

  <!--
    Override the ComputeRunArguments target from Microsoft.NET.Sdk.targets.
    This is the official extensibility point for customizing 'dotnet run'.
    For packaged apps, this sets RunCommand to use our CLI-based launcher.
  -->
  <Target Name="_WinAppPrepareRunArguments"
          BeforeTargets="ComputeRunArguments"
          DependsOnTargets="_WinAppBuildRunArgs;_WinAppCopyContentToLooseLayout"
          Condition="'$(_WinAppRunSupportActive)' == 'true'">
    
    <PropertyGroup>
      <RunCommand>$(WinAppCliPath)</RunCommand>
      <!--
        RunArguments ends with a bare separator token so that `dotnet run` behaves the same way for a
        project that references this package as it does for one that does not.

        The .NET SDK appends the user's application arguments to RunArguments verbatim
        (RunProperties.WithApplicationArguments -> CommonRunHelpers.CombineRunArguments with
        appendApplicationArgumentsToBase: true), and any standalone separator the user typed is
        consumed by System.CommandLine while parsing `dotnet run` itself and never re-emitted.
        `dotnet run xyz` and `dotnet run [separator] xyz` therefore arrive here identically.

        Without the trailing separator those tokens land in winapp's own option namespace, so an
        argument that happens to share a name with a winapp option would configure the launcher
        instead of reaching the application - a silent difference from an unpackaged app. The
        trailing separator puts every appended token in winapp's passthrough region, which forwards
        them to the launched application unchanged.

        winapp itself is configured through the WinAppRun* properties above, which MSBuild consumes,
        so they never reach this list. A trailing separator with nothing after it is valid and
        launches with no application arguments.
      -->
      <RunArguments>$(_WinAppRunArgs) --</RunArguments>
      <RunWorkingDirectory>$(MSBuildProjectDirectory)</RunWorkingDirectory>
    </PropertyGroup>
    
    <Message Text="[WinAppRunSupport] Intercepted 'dotnet run' for packaged app" Importance="high" />
    <Message Text="[WinAppRunSupport] RunCommand: $(RunCommand)" Importance="normal" />
    <Message Text="[WinAppRunSupport] RunArguments: $(RunArguments)" Importance="normal" />
  </Target>

  <!--
    Seed the run properties during a plain build of a file-based app.

    'dotnet build app.cs' records RunCommand, RunArguments and RunWorkingDirectory in the SDK's
    build success cache, and a later 'dotnet run app.cs' replays that cache instead of re-evaluating
    the project when nothing has changed. ComputeRunArguments does not run during a plain build, so
    the SDK falls back to TargetPath and the cache captures the bare apphost. The next
    'dotnet run app.cs' would then replay that entry and silently launch the app unpackaged.
    Preparing the same properties after Build keeps the cached entry and the redirect in agreement,
    so the app runs packaged no matter which command populated the cache.

    Scoped to file-based apps on purpose: a project file has no such cache, and preparing run
    arguments on every build would add loose layout copying to a plain build.
  -->
  <Target Name="_WinAppPrepareRunArgumentsForFileBasedBuild"
          AfterTargets="Build"
          DependsOnTargets="_WinAppPrepareRunArguments"
          Condition="'$(_WinAppRunSupportActive)' == 'true' And '$(_WinAppFileBasedApp)' == 'true'" />

  <!--
    ============================================================================
    Debugging Support
    
    Target to help with debugging and diagnostics.
    ============================================================================
  -->
  <Target Name="WinAppRunSupportInfo">
    <Message Text="=== WinApp Run Support Information ===" Importance="high" />
    <Message Text="_WinAppRunSupportActive: $(_WinAppRunSupportActive)" Importance="high" />
    <Message Text="EnableWinAppRunSupport: $(EnableWinAppRunSupport)" Importance="high" />
    <Message Text="WindowsPackageType: $(WindowsPackageType)" Importance="high" />
    <Message Text="OutputType: $(OutputType)" Importance="high" />
    <Message Text="TargetFramework: $(TargetFramework)" Importance="high" />
    <Message Text="TargetPlatformIdentifier (raw): $(TargetPlatformIdentifier)" Importance="high" />
    <Message Text="_WinAppEffectiveTargetPlatformIdentifier (used by gate): $(_WinAppEffectiveTargetPlatformIdentifier)" Importance="high" />
    <Message Text="FileBasedProgram: $(FileBasedProgram)" Importance="high" />
    <Message Text="EntryPointFilePath: $(EntryPointFilePath)" Importance="high" />
    <Message Text="_WinAppFileBasedApp (used by gate): $(_WinAppFileBasedApp)" Importance="high" />
    <Message Text="RuntimeIdentifier: $(RuntimeIdentifier)" Importance="high" />
    <Message Text="WinAppCliPath: $(WinAppCliPath)" Importance="high" />
    <Message Text="WinAppCliArch: $(WinAppCliArch)" Importance="high" />
    <Message Text="WinAppManifestPath: $(WinAppManifestPath)" Importance="high" />
    <Message Text="_WinAppManifestPathUserSet: $(_WinAppManifestPathUserSet)" Importance="high" />
    <Message Text="WinAppLooseLayoutPath: $(WinAppLooseLayoutPath)" Importance="high" />
    <Message Text="(For the exact CLI command: -t:_WinAppBuildRunArgs -getProperty:_WinAppRunArgs)" Importance="high" />
    <Message Text="======================================" Importance="high" />
  </Target>

</Project>
