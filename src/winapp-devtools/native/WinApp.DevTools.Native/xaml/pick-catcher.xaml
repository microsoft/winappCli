        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="$W$" Height="$H$" Background="#00000000" BorderThickness="0"
        AutomationProperties.AutomationId="WinAppDevToolsPickCatcher"
        AutomationProperties.Name="Pick target" />
