
<Canvas xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Name="DevToolsSelRoot" Width="$W$" Height="$H$" Canvas.ZIndex="2000"
        AutomationProperties.AutomationId="DevToolsSelAnchor">

  <!-- Display only — it must never eat a click aimed at the element under it. -->
  <Border x:Name="DevToolsSelTag" Canvas.Left="$TAGX$" Canvas.Top="$TAGY$" Canvas.ZIndex="2001"
          Visibility="$TAGVIS$"
          Background="$SURFACE$" BorderBrush="$RIM$" BorderThickness="1" CornerRadius="5" Padding="7,5"
          IsHitTestVisible="False"
          AutomationProperties.AutomationId="DevToolsSelTag"
          AutomationProperties.Name="Selected element">
    <StackPanel Orientation="Horizontal" Spacing="7">
      <TextBlock x:Name="DevToolsSelTagText" Text="$TAGTEXT$" FontSize="11" FontWeight="SemiBold"
                 Foreground="$TEXT$" VerticalAlignment="Center" />
      <TextBlock x:Name="DevToolsSelTagDim" Text="$TAGDIM$" FontSize="11" Foreground="$TEXTTERTIARY$"
                 VerticalAlignment="Center" />
    </StackPanel>
  </Border>
$PANEL$
</Canvas>
