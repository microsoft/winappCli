
<!-- Opposite Light/Dark theme keeps chrome distinct; High Contrast inherits platform resources. Attach/reveal
     animations are one-shot, not continuous work in the inspected app. -->
<Canvas xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Name="DevToolsRoot" Width="$W$" Height="$H$">

  <Canvas.Resources>

    <!-- FillBehavior="Stop" returns the glow to its local opacity, so the attach pulse does not keep running. -->
    <Storyboard x:Name="DevToolsAttachPulse">
      <DoubleAnimation Storyboard.TargetName="DevToolsGlowHalo" Storyboard.TargetProperty="Opacity"
                       From="0.22" To="0.66" Duration="0:0:0.5" AutoReverse="True" FillBehavior="Stop" />
    </Storyboard>

    <!-- One-shot reveal holds the visible end state after the bar docks. -->
    <Storyboard x:Name="DevToolsBarReveal">
      <DoubleAnimation Storyboard.TargetName="DevToolsBar" Storyboard.TargetProperty="Opacity"
                       From="0.0" To="1.0" Duration="0:0:0.18" />
      <DoubleAnimation Storyboard.TargetName="DevToolsBarShift" Storyboard.TargetProperty="Y"
                       From="8" To="0" Duration="0:0:0.18" />
    </Storyboard>
  </Canvas.Resources>

  <!-- NO fixed Width -- it auto-sizes to its label and the code re-anchors it from the selected corner. -->
  <Border x:Name="DevToolsChip" Canvas.Left="$CHIPX$" Canvas.Top="$CHIPY$" Canvas.ZIndex="1000" Height="$CHIPH$"
          RequestedTheme="$TOOLBARTHEME$"
          Background="$SURFACE$" CornerRadius="14" BorderBrush="$RIM$" BorderThickness="1"
          BackgroundSizing="InnerBorderEdge"
          IsTabStop="True" UseSystemFocusVisuals="True"
          AutomationProperties.AutomationId="DevToolsProtoRailL"
          AutomationProperties.Name="DevTools (open toolbar)"
          AutomationProperties.AcceleratorKey="Ctrl+Shift+F12">
    <Border.Transitions>
      <TransitionCollection>
        <EntranceThemeTransition FromVerticalOffset="6" />
      </TransitionCollection>
    </Border.Transitions>
    <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center" Margin="12,0,13,0">

      <!-- The container MUST be >= the halo: a 16px halo in a 10px Grid was clipped to the Grid's bounds and

           rendered as a solid pale SQUARE around the dot. The ON pair is a second, accent-tinted dot+halo

           toggled by Visibility rather than a runtime brush swap -- the ove. -->
      <Grid Width="18" Height="18" VerticalAlignment="Center">
        <Ellipse x:Name="DevToolsGlowHalo" Width="16" Height="16" Fill="$LIVE$" Opacity="0.22"
                 HorizontalAlignment="Center" VerticalAlignment="Center" />
        <Ellipse x:Name="DevToolsGlowHaloOn" Width="16" Height="16" Fill="$ACCENT$" Opacity="0.28" Visibility="Collapsed"
                 HorizontalAlignment="Center" VerticalAlignment="Center" />
        <Ellipse x:Name="DevToolsChipDot" Width="8" Height="8" Fill="$LIVE$"
                 HorizontalAlignment="Center" VerticalAlignment="Center" />
        <Ellipse x:Name="DevToolsChipDotOn" Width="8" Height="8" Fill="$ACCENT$" Visibility="Collapsed"
                 HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Grid>
      <TextBlock x:Name="DevToolsChipLabel" Text="DevTools" FontSize="12" FontWeight="SemiBold"
                 VerticalAlignment="Center" Foreground="$TEXT$"
                 AutomationProperties.AutomationId="DevToolsChipLabel" />
      <Border x:Name="DevToolsChipCount" Visibility="Collapsed" MinWidth="16" Height="16" CornerRadius="8"
              Padding="5,0" Background="$ACCENT$" VerticalAlignment="Center"
              AutomationProperties.AutomationId="DevToolsChipCount">
        <TextBlock x:Name="DevToolsChipCountText" Text="0" FontSize="10" FontWeight="SemiBold"
                   Foreground="$ACCENTTEXT$" HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Border>
    </StackPanel>
  </Border>

  <!-- Hidden controls must not enlarge the Popup's bounds. -->
  <Border x:Name="DevToolsBar" Visibility="Collapsed" Canvas.ZIndex="1001" Width="$BARW$" Height="$BARH$"
          RequestedTheme="$TOOLBARTHEME$"
          Background="$SURFACE$" CornerRadius="8" BorderBrush="$RIM$" BorderThickness="1" Padding="6,0"
          BackgroundSizing="InnerBorderEdge"
          AutomationProperties.AutomationId="DevToolsProtoPill"
          AutomationProperties.Name="DevTools toolbar"
          AutomationProperties.AcceleratorKey="Ctrl+Shift+F12"
          ToolTipService.ToolTip="DevTools (Ctrl+Shift+F12)">
    <Border.RenderTransform>
      <TranslateTransform x:Name="DevToolsBarShift" />
    </Border.RenderTransform>
    <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
      <Border x:Name="DevToolsDragHandle" Width="24" Height="24" CornerRadius="5" Background="#00000000"
              VerticalAlignment="Center" Margin="0,0,2,0"
              ToolTipService.ToolTip="Drag to move DevTools to another corner"
              AutomationProperties.AutomationId="DevToolsDragHandle"
              AutomationProperties.Name="Move DevTools (drag)">
        <Grid Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center">
          <Ellipse x:Name="DevToolsDragHalo" Width="16" Height="16" Fill="$LIVE$" Opacity="0.22"
                   HorizontalAlignment="Center" VerticalAlignment="Center" />
          <Ellipse x:Name="DevToolsDragHaloOn" Width="16" Height="16" Fill="$LIVE$" Opacity="0.6" Visibility="Collapsed"
                   HorizontalAlignment="Center" VerticalAlignment="Center" />
          <Ellipse Width="8" Height="8" Fill="$LIVE$" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>
      </Border>
      <ToggleButton x:Name="DevToolsProtoPick" Style="{x:Null}" AllowFocusOnInteraction="False" Width="30" Height="26" Padding="0" BorderThickness="0" CornerRadius="6"
              Background="#00000000" Foreground="$TEXT$" VerticalAlignment="Center"
              IsEnabled="$PICKENABLED$"
              ToolTipService.ToolTip="Select an element to inspect (Esc to exit)"
              AutomationProperties.AutomationId="DevToolsProtoPick"
              AutomationProperties.Name="Select element">
        <ToggleButton.Resources>
          <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="Transparent" />
          <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="Transparent" />
          <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="Transparent" />
          <SolidColorBrush x:Key="ToggleButtonBorderBrushChecked" Color="Transparent" />
          <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPointerOver" Color="Transparent" />
          <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPressed" Color="Transparent" />
        </ToggleButton.Resources>
        <Grid Width="30" Height="26">
          <FontIcon x:Name="DevToolsPickOff" FlowDirection="LeftToRight" Glyph="&#xE7C9;"
                    FontSize="15" Foreground="$TEXT$" HorizontalAlignment="Center" VerticalAlignment="Center" />
          <Grid x:Name="DevToolsPickOn" Visibility="Collapsed" AutomationProperties.AutomationId="DevToolsPickOn">
            <Border Width="30" Height="26" CornerRadius="6" Background="$ACCENT$" />
            <FontIcon FlowDirection="LeftToRight" Glyph="&#xE7C9;" FontSize="15"
                      Foreground="$ACCENTTEXT$" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Grid>
        </Grid>
      </ToggleButton>
      <!-- Comment mode is a mode like Pick; the chevron beside it opens the comment actions. -->
      <ToggleButton x:Name="DevToolsProtoComments" Style="{x:Null}" AllowFocusOnInteraction="False" Width="34" Height="26" Padding="0" BorderThickness="0" CornerRadius="6,0,0,6"
              Background="#00000000" Foreground="$TEXT$" VerticalAlignment="Center"
              IsEnabled="$PICKENABLED$"
              ToolTipService.ToolTip="Comment on elements (Esc to exit)"
              AutomationProperties.AutomationId="DevToolsProtoComments"
              AutomationProperties.Name="Comment mode">
        <ToggleButton.Resources>
          <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="Transparent" />
          <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="Transparent" />
          <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="Transparent" />
          <SolidColorBrush x:Key="ToggleButtonBorderBrushChecked" Color="Transparent" />
          <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPointerOver" Color="Transparent" />
          <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPressed" Color="Transparent" />
        </ToggleButton.Resources>
        <Grid Width="34" Height="26">
          <FontIcon x:Name="DevToolsCommentsOff" FlowDirection="LeftToRight" Glyph="&#xE90A;" FontSize="15"
                    Foreground="$TEXT$" HorizontalAlignment="Center" VerticalAlignment="Center" />
          <Grid x:Name="DevToolsCommentsOn" Visibility="Collapsed" AutomationProperties.AutomationId="DevToolsCommentsOn">
            <Border Width="34" Height="26" CornerRadius="6,0,0,6" Background="$ACCENT$" />
            <FontIcon FlowDirection="LeftToRight" Glyph="&#xE90A;" FontSize="15"
                      Foreground="$ACCENTTEXT$" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Grid>
          <Border x:Name="DevToolsCommentBadge" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Top"
                  MinWidth="14" Height="14" CornerRadius="7" Padding="4,0" Background="$ACCENT$"
                  BorderBrush="$SURFACE$" BorderThickness="1"
                  AutomationProperties.AutomationId="DevToolsCommentBadge">
            <TextBlock x:Name="DevToolsCommentBadgeText" Text="0" FontSize="9" FontWeight="SemiBold"
                       Foreground="$ACCENTTEXT$" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
        </Grid>
      </ToggleButton>
      <Button x:Name="DevToolsProtoCommentsMenu" Style="{x:Null}" AllowFocusOnInteraction="False" Width="16" Height="26" Padding="0" BorderThickness="0" CornerRadius="0,6,6,0"
              Background="#00000000" Foreground="$TEXT$" VerticalAlignment="Center" Margin="-3,0,0,0"
              ToolTipService.ToolTip="More comment actions"
              AutomationProperties.AutomationId="DevToolsProtoCommentsMenu"
              AutomationProperties.Name="More comment actions">
        <FontIcon FlowDirection="LeftToRight" Glyph="&#xE70D;" FontSize="8" Foreground="$TEXT$" />
      </Button>      <!-- Layout adorners are a mode: a ToggleButton exposes the on-state to UI Automation. -->
      <ToggleButton x:Name="DevToolsProtoLayout" Style="{x:Null}" AllowFocusOnInteraction="False" Width="30" Height="26" Padding="0" BorderThickness="0" CornerRadius="6"
              Background="#00000000" Foreground="$TEXT$" VerticalAlignment="Center"
              ToolTipService.ToolTip="Layout adorners (margin, padding, alignment)"
              AutomationProperties.AutomationId="DevToolsProtoLayout"
              AutomationProperties.Name="Layout adorners">
        <ToggleButton.Resources>
          <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="Transparent" />
          <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="Transparent" />
          <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="Transparent" />
          <SolidColorBrush x:Key="ToggleButtonBorderBrushChecked" Color="Transparent" />
          <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPointerOver" Color="Transparent" />
          <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPressed" Color="Transparent" />
        </ToggleButton.Resources>
        <Grid Width="30" Height="26">
          <FontIcon x:Name="DevToolsLayoutOff" FlowDirection="LeftToRight" Glyph="&#xE80A;"
                    FontSize="15" Foreground="$TEXT$" HorizontalAlignment="Center" VerticalAlignment="Center" />
          <Grid x:Name="DevToolsLayoutOn" Visibility="Collapsed" AutomationProperties.AutomationId="DevToolsLayoutOn">
            <Border Width="30" Height="26" CornerRadius="6" Background="$ACCENT$" />
            <FontIcon FlowDirection="LeftToRight" Glyph="&#xE80A;" FontSize="15"
                      Foreground="$ACCENTTEXT$" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Grid>
        </Grid>
      </ToggleButton>

      <!-- The overlay itself keeps its fixed opaque palette, so this action cannot make the tooling illegible. -->
      <Button x:Name="DevToolsProtoTheme" Style="{x:Null}" AllowFocusOnInteraction="False" Width="30" Height="26" Padding="0" BorderThickness="0" CornerRadius="6"
              Background="#00000000" Foreground="$TEXT$" VerticalAlignment="Center"
              IsEnabled="$THEMEENABLED$"
              ToolTipService.ToolTip="Switch app theme"
              AutomationProperties.AutomationId="DevToolsProtoTheme"
              AutomationProperties.Name="Switch app theme">
        <FontIcon FlowDirection="LeftToRight" Glyph="&#xE706;" FontSize="15"
                  Foreground="$TEXT$" />
      </Button>

      <!-- Separator uses the internal border brush, not the outer rim. -->
      <Border Width="1" Height="18" Background="$BORDER$" Margin="3,0" VerticalAlignment="Center" />

      <Button x:Name="DevToolsProtoInspect" Style="{x:Null}" AllowFocusOnInteraction="False" Width="30" Height="26" Padding="0" BorderThickness="0" CornerRadius="6"
              Background="#00000000" Foreground="$TEXT$" VerticalAlignment="Center"
              ToolTipService.ToolTip="Open the DevTools window"
              AutomationProperties.AutomationId="DevToolsProtoInspect"
              AutomationProperties.Name="Open DevTools window">
        <FontIcon FlowDirection="LeftToRight" Glyph="&#xE8A7;" FontSize="15" Foreground="$TEXT$" />
      </Button>
      <Button x:Name="DevToolsProtoMore" Style="{x:Null}" AllowFocusOnInteraction="False" Width="24" Height="24" Padding="0" BorderThickness="0" CornerRadius="5"
              Background="#00000000" Foreground="$TEXTDIM$" VerticalAlignment="Center"
              ToolTipService.ToolTip="More options"
              AutomationProperties.AutomationId="DevToolsProtoMore"
              AutomationProperties.Name="More options">
        <FontIcon FlowDirection="LeftToRight" Glyph="&#xE712;" FontSize="14" Foreground="$TEXTDIM$" />
      </Button>    </StackPanel>
  </Border>
  <Grid Visibility="Collapsed" Canvas.ZIndex="1010" Width="$SNAPW$" Height="$SNAPH$"
        IsHitTestVisible="False" AutomationProperties.AutomationId="DevToolsSnapBR">
    <Border CornerRadius="16" BorderBrush="$TEXTTERTIARY$" BorderThickness="2" />
    <Border x:Name="DevToolsSnapNear0" Visibility="Collapsed" CornerRadius="16" BorderBrush="$ACCENT$"
            BorderThickness="2" Background="$SNAPFILL$" />
  </Grid>
  <Grid Visibility="Collapsed" Canvas.ZIndex="1010" Width="$SNAPW$" Height="$SNAPH$"
        IsHitTestVisible="False" AutomationProperties.AutomationId="DevToolsSnapBL">
    <Border CornerRadius="16" BorderBrush="$TEXTTERTIARY$" BorderThickness="2" />
    <Border x:Name="DevToolsSnapNear1" Visibility="Collapsed" CornerRadius="16" BorderBrush="$ACCENT$"
            BorderThickness="2" Background="$SNAPFILL$" />
  </Grid>
  <Grid Visibility="Collapsed" Canvas.ZIndex="1010" Width="$SNAPW$" Height="$SNAPH$"
        IsHitTestVisible="False" AutomationProperties.AutomationId="DevToolsSnapTL">
    <Border CornerRadius="16" BorderBrush="$TEXTTERTIARY$" BorderThickness="2" />
    <Border x:Name="DevToolsSnapNear2" Visibility="Collapsed" CornerRadius="16" BorderBrush="$ACCENT$"
            BorderThickness="2" Background="$SNAPFILL$" />
  </Grid>
  <Grid Visibility="Collapsed" Canvas.ZIndex="1010" Width="$SNAPW$" Height="$SNAPH$"
        IsHitTestVisible="False" AutomationProperties.AutomationId="DevToolsSnapTR">
    <Border CornerRadius="16" BorderBrush="$TEXTTERTIARY$" BorderThickness="2" />
    <Border x:Name="DevToolsSnapNear3" Visibility="Collapsed" CornerRadius="16" BorderBrush="$ACCENT$"
            BorderThickness="2" Background="$SNAPFILL$" />
  </Grid>
  <Grid Visibility="Collapsed" Canvas.ZIndex="1010" Width="$SNAPW$" Height="$SNAPH$"
        IsHitTestVisible="False" AutomationProperties.AutomationId="DevToolsSnapTC">
    <Border CornerRadius="16" BorderBrush="$TEXTTERTIARY$" BorderThickness="2" />
    <Border x:Name="DevToolsSnapNear4" Visibility="Collapsed" CornerRadius="16" BorderBrush="$ACCENT$"
            BorderThickness="2" Background="$SNAPFILL$" />
  </Grid>
  <Grid Visibility="Collapsed" Canvas.ZIndex="1010" Width="$SNAPW$" Height="$SNAPH$"
        IsHitTestVisible="False" AutomationProperties.AutomationId="DevToolsSnapBC">
    <Border CornerRadius="16" BorderBrush="$TEXTTERTIARY$" BorderThickness="2" />
    <Border x:Name="DevToolsSnapNear5" Visibility="Collapsed" CornerRadius="16" BorderBrush="$ACCENT$"
            BorderThickness="2" Background="$SNAPFILL$" />
  </Grid>
  <!-- Toolbar menus open beside the bar, in the same layer, so they stay out of the app's popups. They follow the snap
       targets because those are found by their position among the canvas children. -->
  <!-- Every menu row shares one 14px check column, so check marks, radio marks and labels line up. -->
  <Border x:Name="DevToolsCommentsMenu" Visibility="Collapsed" Canvas.ZIndex="1002" Width="220"
          RequestedTheme="$TOOLBARTHEME$"
          Background="$SURFACE$" CornerRadius="8" BorderBrush="$RIM$" BorderThickness="1" Padding="4"
          BackgroundSizing="InnerBorderEdge"
          AutomationProperties.AutomationId="DevToolsCommentsMenu"
          AutomationProperties.Name="Comment actions">
    <StackPanel>
      <Button x:Name="DevToolsShowAllComments" Style="{x:Null}" AllowFocusOnInteraction="False" Height="32" Padding="32,0,10,0" BorderThickness="0" CornerRadius="4"
              HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="#00000000" Foreground="$TEXT$"
              AutomationProperties.AutomationId="DevToolsShowAllComments">
        <TextBlock x:Name="DevToolsShowAllCommentsText" Text="Open comments list" FontSize="12" Foreground="$TEXT$" VerticalAlignment="Center" />
      </Button>
      <Border Height="1" Margin="6,4" Background="$RIM$" />
      <ToggleButton x:Name="DevToolsToggleMarkers" Style="{x:Null}" AllowFocusOnInteraction="False" Height="32" Padding="10,0" BorderThickness="0" CornerRadius="4"
              HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="#00000000" Foreground="$TEXT$"
              AutomationProperties.AutomationId="DevToolsToggleMarkers"
              AutomationProperties.Name="Show comment markers">
        <ToggleButton.Resources>
          <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="Transparent" />
          <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="Transparent" />
          <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="Transparent" />
          <SolidColorBrush x:Key="ToggleButtonBorderBrushChecked" Color="Transparent" />
          <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPointerOver" Color="Transparent" />
          <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPressed" Color="Transparent" />
          <SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="$TEXT$" />
        </ToggleButton.Resources>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Grid Width="14">
            <FontIcon x:Name="DevToolsMarkersCheck" FlowDirection="LeftToRight" Glyph="&#xE73E;" FontSize="12" Visibility="Collapsed"
                      Foreground="$TEXT$" VerticalAlignment="Center" />
          </Grid>
          <TextBlock Text="Show comment markers" FontSize="12" Foreground="$TEXT$" VerticalAlignment="Center" />
        </StackPanel>
      </ToggleButton>
    </StackPanel>
  </Border>
  <Border x:Name="DevToolsMoreMenu" Visibility="Collapsed" Canvas.ZIndex="1002" Width="240"
          RequestedTheme="$TOOLBARTHEME$"
          Background="$SURFACE$" CornerRadius="8" BorderBrush="$RIM$" BorderThickness="1" Padding="4"
          BackgroundSizing="InnerBorderEdge"
          AutomationProperties.AutomationId="DevToolsMoreMenu"
          AutomationProperties.Name="More options">
    <Border.Resources>
      <!-- A radio menu row: the dot sits in the check column, so radio rows align with check rows. -->
      <ControlTemplate x:Key="DevToolsMenuRadio" TargetType="RadioButton">
        <Grid x:Name="Row" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}" ColumnSpacing="8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="14" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="CommonStates">
              <VisualState x:Name="Normal" />
              <VisualState x:Name="PointerOver">
                <VisualState.Setters><Setter Target="Row.Background" Value="{ThemeResource ButtonBackgroundPointerOver}" /></VisualState.Setters>
              </VisualState>
              <VisualState x:Name="Pressed">
                <VisualState.Setters><Setter Target="Row.Background" Value="{ThemeResource ButtonBackgroundPressed}" /></VisualState.Setters>
              </VisualState>
              <VisualState x:Name="Disabled" />
            </VisualStateGroup>
            <VisualStateGroup x:Name="CheckStates">
              <VisualState x:Name="Checked">
                <VisualState.Setters><Setter Target="Dot.Opacity" Value="1" /></VisualState.Setters>
              </VisualState>
              <VisualState x:Name="Unchecked" />
              <VisualState x:Name="Indeterminate" />
            </VisualStateGroup>
          </VisualStateManager.VisualStateGroups>
          <Ellipse x:Name="Dot" Width="6" Height="6" Opacity="0" Fill="{TemplateBinding Foreground}"
                   HorizontalAlignment="Center" VerticalAlignment="Center" />
          <ContentPresenter Grid.Column="1" Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                            FontSize="12" VerticalAlignment="Center" />
        </Grid>
      </ControlTemplate>
    </Border.Resources>
    <StackPanel>
      <Button x:Name="DevToolsHideToolbar" Style="{x:Null}" AllowFocusOnInteraction="False" Height="32" Padding="10,0" BorderThickness="0" CornerRadius="4"
              HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Background="#00000000" Foreground="$TEXT$"
              AutomationProperties.AutomationId="DevToolsHideToolbar"
              AutomationProperties.Name="Hide toolbar" AutomationProperties.AcceleratorKey="Ctrl+Shift+F12">
        <Grid ColumnSpacing="8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="14" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="1" Text="Hide toolbar" FontSize="12" Foreground="$TEXT$" VerticalAlignment="Center" />
          <TextBlock Grid.Column="2" Text="Ctrl+Shift+F12" FontSize="11" Foreground="$TEXTDIM$" VerticalAlignment="Center" />
        </Grid>
      </Button>
      <ToggleButton x:Name="DevToolsProtoPin" Style="{x:Null}" AllowFocusOnInteraction="False" Height="32" Padding="10,0" BorderThickness="0" CornerRadius="4"
              HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="#00000000" Foreground="$TEXT$"
              AutomationProperties.AutomationId="DevToolsProtoPin"
              AutomationProperties.Name="Keep toolbar open">
        <ToggleButton.Resources>
          <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="Transparent" />
          <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="Transparent" />
          <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="Transparent" />
          <SolidColorBrush x:Key="ToggleButtonBorderBrushChecked" Color="Transparent" />
          <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPointerOver" Color="Transparent" />
          <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPressed" Color="Transparent" />
          <SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="$TEXT$" />
        </ToggleButton.Resources>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Grid Width="14">
            <FontIcon x:Name="DevToolsPinOn" FlowDirection="LeftToRight" Glyph="&#xE73E;" FontSize="12" Visibility="Collapsed"
                      Foreground="$TEXT$" VerticalAlignment="Center" />
          </Grid>
          <TextBlock Text="Keep toolbar open" FontSize="12" Foreground="$TEXT$" VerticalAlignment="Center" />
        </StackPanel>
      </ToggleButton>
      <Border Height="1" Margin="6,4" Background="$RIM$" />
      <TextBlock Text="WHEN THE APP STARTS" Height="24" Padding="32,6,10,0" FontSize="10" CharacterSpacing="60"
                 Foreground="$TEXTDIM$" AutomationProperties.HeadingLevel="Level1" />
      <RadioButton x:Name="DevToolsStartShown" GroupName="DevToolsDefaultMode" Template="{StaticResource DevToolsMenuRadio}"
              AllowFocusOnInteraction="False" UseSystemFocusVisuals="True" Height="32" Padding="10,0"
              HorizontalAlignment="Stretch" Background="#00000000" Foreground="$TEXT$" Content="Show toolbar"
              AutomationProperties.AutomationId="DevToolsStartShown" />
      <RadioButton x:Name="DevToolsStartHidden" GroupName="DevToolsDefaultMode" Template="{StaticResource DevToolsMenuRadio}"
              AllowFocusOnInteraction="False" UseSystemFocusVisuals="True" Height="32" Padding="10,0"
              HorizontalAlignment="Stretch" Background="#00000000" Foreground="$TEXT$" Content="Hide toolbar"
              ToolTipService.ToolTip="DevTools starts with nothing drawn in the app. Press Ctrl+Shift+F12 to show the toolbar."
              AutomationProperties.AutomationId="DevToolsStartHidden" />
      <RadioButton x:Name="DevToolsStartOff" GroupName="DevToolsDefaultMode" Template="{StaticResource DevToolsMenuRadio}"
              AllowFocusOnInteraction="False" UseSystemFocusVisuals="True" Height="32" Padding="10,0"
              HorizontalAlignment="Stretch" Background="#00000000" Foreground="$TEXT$" Content="Don't start DevTools"
              ToolTipService.ToolTip="Turn DevTools back on with: winapp devtools default on"
              AutomationProperties.AutomationId="DevToolsStartOff" />
    </StackPanel>
  </Border></Canvas>
