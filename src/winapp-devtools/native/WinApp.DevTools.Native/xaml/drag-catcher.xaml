
<!-- Transparent Border handles press/move/release; ButtonBase would consume pointer events. -->
<Border xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Canvas.Left="0" Canvas.Top="0" Canvas.ZIndex="3000"
        Width="$W$" Height="$H$" Background="#00000000" BorderThickness="0"
        AutomationProperties.AutomationId="WinAppDevToolsDragCatcher"
        AutomationProperties.Name="Moving the DevTools toolbar" />
