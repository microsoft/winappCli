<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>winapp</AssemblyName>
    <ApplicationIcon>Assets\winapp.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Description>A command-line tool for managing Windows SDKs, packaging, generating app identity, manifests, certificates, and using build tools with any app framework.</Description>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- Enable Code Analysis -->
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisMode>Recommended</AnalysisMode>
    
    <!-- Suppress specific warnings -->
    <NoWarn>CA1852</NoWarn>

    <!-- NativeAOT / single-file / self-contained (RID specified at publish time) -->
    <PublishAot>true</PublishAot>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TrimmerRootDescriptor>TrimRoots.xml</TrimmerRootDescriptor>
    <OptimizationPreference>Size</OptimizationPreference>
    <TrimMode>full</TrimMode>
    <CsWin32RunAsBuildTask>true</CsWin32RunAsBuildTask>
    <DisableRuntimeMarshalling>true</DisableRuntimeMarshalling>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    
    <!-- Faster startup for single-file -->
    <IncludeNativeLibrariesForSelfExtract>false</IncludeNativeLibrariesForSelfExtract>
    <DebuggerSupport>false</DebuggerSupport>
    <EventSourceSupport>true</EventSourceSupport>

    <!-- Allow test project to access internal types -->
    <InternalsVisibleTo>WinApp.Cli.Tests</InternalsVisibleTo>
    <InternalsVisibleTo>WinApp.Cli.SnapshotBaker</InternalsVisibleTo>

    <!-- The *first* DefineConstants is removed during Official Release Builds (.pipelines/Unstub.ps1)-->
    <DefineConstants>TELEMETRYEVENTSOURCE_PUBLIC</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
  </PropertyGroup>

  <ItemGroup>
    <!-- Embed templates and default MSIX assets -->
    <EmbeddedResource Include="Templates\**\*.*" />
    <EmbeddedResource Include="Assets\msix_default_assets\**\*.*" />
  </ItemGroup>

  <ItemGroup>
    <!-- find-ui curated enrichment (tags/keywords) + core patterns. -->
    <EmbeddedResource Include="Services\Controls\Data\core-patterns.json" LogicalName="core-patterns.json" />
    <EmbeddedResource Include="Services\Controls\Data\gallery-tags.json" LogicalName="gallery-tags.json" />
    <!--
      The baked corpus floor (see EmbeddedSnapshot.cs). Only the Brotli blob is committed
      and embedded: the corpus is a backup for the offline case, refreshed wholesale by
      the release bake, so release time is its source of truth rather than a committed
      text copy. snapshot-manifest.json stays readable so per-source scenario counts are
      still reviewable in a diff.
    -->
    <EmbeddedResource Include="Services\Controls\Data\snapshot-manifest.json"
                      LogicalName="snapshot-manifest.json"
                      Condition="Exists('Services\Controls\Data\snapshot-manifest.json')" />
    <EmbeddedResource Include="Services\Controls\Data\snapshot-*.json.br">
      <LogicalName>%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Identity" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" />
    <PackageReference Include="Microsoft.Windows.CsWin32">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Spectre.Console" />
    <PackageReference Include="Svg.Skia" />
    <PackageReference Include="System.CommandLine" />
    <PackageReference Include="System.Diagnostics.EventLog" />
    <PackageReference Include="System.Drawing.Common" />
    <PackageReference Include="Microsoft.Diagnostics.Runtime" />
    <PackageReference Include="Microsoft.Diagnostics.Runtime.Utilities" />
    <!-- NuGet client libraries: let winapp honor the user's nuget.config (custom/private package
         sources, credentials, globalPackagesFolder) when restoring SDK packages. -->
    <PackageReference Include="NuGet.Protocol" />
    <PackageReference Include="NuGet.Packaging" />
    <PackageReference Include="NuGet.Configuration" />
    <PackageReference Include="NuGet.Versioning" />
    <PackageReference Include="NuGet.Credentials" />
    <!-- Native debugging engine bits (dbgeng/dbghelp/dbgcore/dbgmodel/msdia140 + symsrv) used by the
         WinUI triage pass. Restore-only: nothing is bundled into the AOT/single-file output (the
         packages ship native DLLs under content/<arch>/ which PackageReference does not auto-consume,
         and ExcludeAssets="all" makes that explicit). Restoring populates the NuGet global cache so
         dev/CI builds can resolve the bits locally; end users download them on first use. -->
    <PackageReference Include="Microsoft.Debugging.Platform.DbgEng" ExcludeAssets="all" PrivateAssets="all" GeneratePathProperty="true" />
    <PackageReference Include="Microsoft.Debugging.Platform.SymSrv" ExcludeAssets="all" PrivateAssets="all" GeneratePathProperty="true" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WinApp.UIAutomation\WinApp.UIAutomation.csproj" />
    <ProjectReference Include="..\WinApp.UIAutomation.Recording\WinApp.UIAutomation.Recording.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>WinApp.Cli.Tests</_Parameter1>
    </AssemblyAttribute>
    <!-- The OneFuzz harness targets ZipRangeExtractor, which is internal. -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>WinApp.Cli.Fuzz</_Parameter1>
    </AssemblyAttribute>
    <!-- Build-time corpus baker (not shipped). Needs ProviderRegistry, the fetchers and
         PathSafety, which is why the bake cannot simply be a script in CI. -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>WinApp.Cli.SnapshotBaker</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <!-- Make the NuGet client libraries AOT/trim-safe: use the System.Text.Json source-generated
         deserializer and let the linker trim the reflection-based Newtonsoft.Json path entirely.
         https://github.com/NuGet/NuGet.Client/blob/dev/docs/aot-compatibility.md -->
    <RuntimeHostConfigurationOption Include="NuGet.UseSystemTextJsonDeserialization"
                                    Value="true"
                                    Trim="true" />
  </ItemGroup>

</Project>
