<Project Sdk="MSTest.Sdk/4.1.0">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- WinForms is used only by the real-UIA test fixture (UiaTestFixture) to host a
         live in-process window that the real UiAutomationService can inspect and drive. -->
    <UseWindowsForms>true</UseWindowsForms>

    <!-- Enable Code Analysis -->
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisMode>Recommended</AnalysisMode>
    
    <!-- Suppress specific warnings -->
    <!-- SYSLIB1045: inline Regex constructions in test assertions are throwaway literals
         (used by StringAssert.DoesNotMatch); compile-time GeneratedRegex source-gen would
         add zero value here and only bloat the test file. -->
    <NoWarn>CA1852;CA1707;IDE1006;SYSLIB1045</NoWarn>
    
    <!-- Test discovery and execution -->
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>

    <!-- Allow unsafe blocks so SlugGeneratorTests can build a real SAFEARRAY (via oleaut32)
         to exercise SlugGenerator's COM-interop hashing overloads. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!-- Exclude test app source files from compilation -->
    <DefaultItemExcludes>$(DefaultItemExcludes);TestApps\**\*</DefaultItemExcludes>

    <ValidateExecutableReferencesMatchSelfContained>false</ValidateExecutableReferencesMatchSelfContained>
    <ResolveAssemblyWarnOrErrorOnTargetArchitectureMismatch>None</ResolveAssemblyWarnOrErrorOnTargetArchitectureMismatch>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Identity" />
    <PackageReference Include="Spectre.Console.Testing" />
  </ItemGroup>

  <ItemGroup>
    <!-- The published sample-index contract (#703). SampleIndexTests reads it to assert the
         schema we hand upstream and the reader/writer haven't drifted apart. -->
    <Content Include="..\..\..\docs\winui-sample-index.schema.json"
             Link="winui-sample-index.schema.json"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- Aliased so a test can disambiguate CsWin32's PInvoke, which both winapp and the
         recording package generate into their own assembly. -->
    <ProjectReference Include="..\WinApp.Cli\WinApp.Cli.csproj" Aliases="global,winappcli" />
    <ProjectReference Include="..\WinApp.UIAutomation.TestSupport\WinApp.UIAutomation.TestSupport.csproj" />
    <ProjectReference Include="..\WinApp.Cli.Fuzz\WinApp.Cli.Fuzz.csproj" />
    <!-- SampleIndexWriter is build-only (it generates the reference index, which the CLI
         never does), so its contract tests reach into the baker rather than the product. -->
    <ProjectReference Include="..\WinApp.Cli.SnapshotBaker\WinApp.Cli.SnapshotBaker.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Exercise the same System.Text.Json NuGet deserialization path the published CLI uses (see the matching
         option in WinApp.Cli.csproj), so the NuGet integration tests cover the AOT/STJ code path this migration
         depends on instead of the default Newtonsoft.Json reflection path the test host would otherwise use. -->
    <RuntimeHostConfigurationOption Include="NuGet.UseSystemTextJsonDeserialization"
                                    Value="true"
                                    Trim="true" />
  </ItemGroup>

  <ItemGroup>
    <None Update="TestData\WindowsAppModel\appx-manifest-conformance-vectors.json"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
