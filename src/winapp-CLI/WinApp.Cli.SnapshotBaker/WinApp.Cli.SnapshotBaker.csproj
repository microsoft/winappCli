<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Build-time maintenance tool, deliberately OUTSIDE the shipped CLI.

    This exists so regenerating the find-ui corpus is not reachable from the product.
    It previously lived behind a hidden bake option on `winapp find-ui`, but `Hidden`
    only removes an option from help and the CLI schema — it was still parsed, still
    dispatched, and still gave a shipped search command an arbitrary-directory write
    primitive that no user could legitimately call.

    The bake needs internals of WinApp.Cli (ProviderRegistry, the fetchers, PathSafety),
    so it cannot be a plain script; it is a separate executable that references the CLI
    the same way the test project does. It is never packed and never published — only
    `scripts/build-cli.ps1` (on the Stable release path) and the find-ui corpus drift
    workflow run it.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>WinApp.Cli.SnapshotBaker</AssemblyName>
    <RootNamespace>WinApp.Cli.SnapshotBaker</RootNamespace>
    <Description>Build-time tool that regenerates the find-ui corpus embedded in the CLI. Not shipped.</Description>

    <!-- Enable Code Analysis -->
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisMode>Recommended</AnalysisMode>

    <!-- Never ships: not packed, not published, not part of any artifact. -->
    <IsPackable>false</IsPackable>
    <IsPublishable>false</IsPublishable>

    <!-- WinApp.Cli sets SelfContained for its own AOT publish; referencing it from a
         plain framework-dependent tool is fine, but the SDK checks for a mismatch.
         Same opt-out the test project uses. -->
    <ValidateExecutableReferencesMatchSelfContained>false</ValidateExecutableReferencesMatchSelfContained>
  </PropertyGroup>

  <ItemGroup>
    <!-- SampleIndexWriter is internal and lives here rather than in the shipped CLI (winapp
         reads published indexes, it never writes one), so its contract tests need access. -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>WinApp.Cli.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WinApp.Cli\WinApp.Cli.csproj" />
  </ItemGroup>

</Project>
