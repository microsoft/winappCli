{
  "schemaVersion": "1.0",
  "id": "page-root-attribute",
  "title": "Page update: an attribute removed from the <Page> element",
  "description": [
    "The page's root element sets Tag and Background; the save removes both and retitles the page. A clean build shows",
    "neither. Re-running InitializeComponent on the same page object only sets what the new markup's root has, so the",
    "old values stay: inplace differs from a clean build, recreate matches it, shadow keeps the stale values and says so."
  ],
  "app": {
    "template": "app-template",
    "assetsFrom": "samples/winui-app/Assets",
    "projectFile": "TodoBench.csproj",
    "rootNamespace": "TodoBench"
  },
  "parity": {
    "auto": true,
    "root": "RootPage",
    "properties": [
      "Text",
      "Tag",
      "Background",
      "Visibility"
    ]
  },
  "dimensions": [],
  "variants": [
    {
      "id": "default",
      "primary": true,
      "summary": "The only ordering.",
      "choices": {}
    }
  ],
  "setup": [
    {
      "id": "setup-page-xaml",
      "file": "RootPage.xaml",
      "edit": {
        "op": "create-file",
        "text": [
          "<?xml version=\"1.0\" encoding=\"utf-8\" ?>",
          "<Page",
          "    x:Class=\"TodoBench.RootPage\"",
          "    xmlns=\"http://schemas.microsoft.com/winfx/2006/xaml/presentation\"",
          "    xmlns:x=\"http://schemas.microsoft.com/winfx/2006/xaml\"",
          "    Tag=\"tagged\"",
          "    Background=\"Red\">",
          "    <StackPanel x:Name=\"Root\" Padding=\"12\">",
          "        <TextBlock x:Name=\"Heading\" Text=\"Root v1\" />",
          "    </StackPanel>",
          "</Page>"
        ]
      }
    },
    {
      "id": "setup-page-cs",
      "file": "RootPage.xaml.cs",
      "edit": {
        "op": "create-file",
        "text": [
          "using Microsoft.UI.Xaml.Controls;",
          "",
          "namespace TodoBench;",
          "",
          "public sealed partial class RootPage : Page",
          "{",
          "    public RootPage()",
          "    {",
          "        InitializeComponent();",
          "    }",
          "}"
        ]
      }
    },
    {
      "id": "setup-host",
      "file": "MainWindow.xaml",
      "edit": {
        "op": "replace",
        "find": [
          "        <TextBlock",
          "            x:Name=\"StartHere\"",
          "            Margin=\"24\"",
          "            Text=\"Nothing here yet.\" />"
        ],
        "text": [
          "        <Frame x:Name=\"PageFrame\" />"
        ]
      }
    },
    {
      "id": "setup-navigate",
      "file": "MainWindow.xaml.cs",
      "edit": {
        "op": "insert-after",
        "anchor": [
          "        InitializeComponent();"
        ],
        "text": [
          "        PageFrame.Navigate(typeof(RootPage));"
        ]
      }
    }
  ],
  "segments": [
    {
      "kind": "common",
      "phase": "parity",
      "title": "Remove attributes from the page element",
      "actions": [
        {
          "id": "r1-remove-root-attributes",
          "title": "Tag and Background removed from <Page>, heading retitled",
          "file": "RootPage.xaml",
          "edit": {
            "op": "replace",
            "find": [
              "    x:Class=\"TodoBench.RootPage\"",
              "    xmlns=\"http://schemas.microsoft.com/winfx/2006/xaml/presentation\"",
              "    xmlns:x=\"http://schemas.microsoft.com/winfx/2006/xaml\"",
              "    Tag=\"tagged\"",
              "    Background=\"Red\">",
              "    <StackPanel x:Name=\"Root\" Padding=\"12\">",
              "        <TextBlock x:Name=\"Heading\" Text=\"Root v1\" />"
            ],
            "text": [
              "    x:Class=\"TodoBench.RootPage\"",
              "    xmlns=\"http://schemas.microsoft.com/winfx/2006/xaml/presentation\"",
              "    xmlns:x=\"http://schemas.microsoft.com/winfx/2006/xaml\">",
              "    <StackPanel x:Name=\"Root\" Padding=\"12\">",
              "        <TextBlock x:Name=\"Heading\" Text=\"Root v2\" />"
            ]
          },
          "checkpoint": {
            "id": "k-r1-root-attributes",
            "kind": "parity",
            "parity": true,
            "uiChecks": [
              {
                "target": "Heading",
                "assert": "text-equals",
                "value": "Root v2"
              }
            ],
            "runtimeState": "A clean build has no Tag and no Background on the page. Reloading in place keeps the page object, so the values the earlier markup set stay."
          }
        }
      ]
    }
  ]
}
