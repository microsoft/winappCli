{
  "schemaVersion": "1.0",
  "id": "sb-new-controls",
  "title": "Scoreboard: a UserControl and a templated control added while the app runs",
  "description": [
    "A UserControl (XAML and code in one save) is added, used on the page and edited; then a templated control with",
    "Themes\\Generic.xaml is added, used and its template edited. New types need the app's XAML type information to",
    "know them; a templated control also needs Generic.xaml loaded."
  ],
  "app": {
    "template": "app-template",
    "assetsFrom": "samples/winui-app/Assets",
    "projectFile": "TodoBench.csproj",
    "rootNamespace": "TodoBench"
  },
  "parity": {
    "auto": true,
    "root": "HostPage"
  },
  "dimensions": [],
  "variants": [
    {
      "id": "default",
      "primary": true,
      "summary": "The only ordering.",
      "choices": {}
    }
  ],
  "setup": [
    {
      "id": "setup-MainWindow-xaml",
      "file": "MainWindow.xaml",
      "edit": {
        "op": "create-file",
        "text": [
          "<?xml version=\"1.0\" encoding=\"utf-8\" ?>",
          "<Window",
          "    x:Class=\"TodoBench.MainWindow\"",
          "    xmlns=\"http://schemas.microsoft.com/winfx/2006/xaml/presentation\"",
          "    xmlns:x=\"http://schemas.microsoft.com/winfx/2006/xaml\"",
          "    xmlns:local=\"using:TodoBench\"",
          "    Title=\"TodoBench\">",
          "    <Frame x:Name=\"Nav\" />",
          "</Window>"
        ]
      }
    },
    {
      "id": "setup-MainWindow-xaml-cs",
      "file": "MainWindow.xaml.cs",
      "edit": {
        "op": "create-file",
        "text": [
          "using Microsoft.UI.Xaml;",
          "",
          "namespace TodoBench;",
          "",
          "public sealed partial class MainWindow : Window",
          "{",
          "    public MainWindow()",
          "    {",
          "        InitializeComponent();",
          "        Nav.Navigate(typeof(HostPage));",
          "    }",
          "}"
        ]
      }
    },
    {
      "id": "setup-HostPage-xaml",
      "file": "HostPage.xaml",
      "edit": {
        "op": "create-file",
        "text": [
          "<?xml version=\"1.0\" encoding=\"utf-8\" ?>",
          "<Page",
          "    x:Class=\"TodoBench.HostPage\"",
          "    xmlns=\"http://schemas.microsoft.com/winfx/2006/xaml/presentation\"",
          "    xmlns:x=\"http://schemas.microsoft.com/winfx/2006/xaml\"",
          "    xmlns:local=\"using:TodoBench\">",
          "    <StackPanel x:Name=\"Host\" Padding=\"12\" Spacing=\"8\">",
          "        <TextBlock x:Name=\"HostText\" Text=\"controls\" />",
          "    </StackPanel>",
          "</Page>"
        ]
      }
    },
    {
      "id": "setup-HostPage-xaml-cs",
      "file": "HostPage.xaml.cs",
      "edit": {
        "op": "create-file",
        "text": [
          "using Microsoft.UI.Xaml.Controls;",
          "",
          "namespace TodoBench;",
          "",
          "public sealed partial class HostPage : Page",
          "{",
          "    public HostPage()",
          "    {",
          "        InitializeComponent();",
          "    }",
          "}"
        ]
      }
    }
  ],
  "segments": [
    {
      "kind": "common",
      "phase": "scoreboard",
      "title": "Scoreboard: a UserControl and a templated control added while the app runs",
      "actions": [
        {
          "id": "n1-add-usercontrol",
          "title": "Add a UserControl (XAML and code)",
          "edits": [
            {
              "file": "Badge.xaml",
              "edit": {
                "op": "create-file",
                "text": [
                  "<?xml version=\"1.0\" encoding=\"utf-8\" ?>",
                  "<UserControl",
                  "    x:Class=\"TodoBench.Badge\"",
                  "    xmlns=\"http://schemas.microsoft.com/winfx/2006/xaml/presentation\"",
                  "    xmlns:x=\"http://schemas.microsoft.com/winfx/2006/xaml\">",
                  "    <Border Padding=\"4\" BorderThickness=\"1\" BorderBrush=\"Gray\">",
                  "        <TextBlock x:Name=\"BadgeText\" Text=\"{x:Bind Label, Mode=OneWay}\" />",
                  "    </Border>",
                  "</UserControl>"
                ]
              }
            },
            {
              "file": "Badge.xaml.cs",
              "edit": {
                "op": "create-file",
                "text": [
                  "using Microsoft.UI.Xaml;",
                  "using Microsoft.UI.Xaml.Controls;",
                  "",
                  "namespace TodoBench;",
                  "",
                  "public sealed partial class Badge : UserControl",
                  "{",
                  "    public static readonly DependencyProperty LabelProperty =",
                  "        DependencyProperty.Register(nameof(Label), typeof(string), typeof(Badge), new PropertyMetadata(\"badge\"));",
                  "",
                  "    public Badge()",
                  "    {",
                  "        InitializeComponent();",
                  "    }",
                  "",
                  "    public string Label",
                  "    {",
                  "        get => (string)GetValue(LabelProperty);",
                  "        set => SetValue(LabelProperty, value);",
                  "    }",
                  "}"
                ]
              }
            }
          ],
          "checkpoint": {
            "id": "k-n1-add-usercontrol",
            "kind": "live",
            "uiChecks": [
              {
                "target": "HostText",
                "assert": "text-equals",
                "value": "controls"
              }
            ]
          }
        },
        {
          "id": "n2-use-usercontrol",
          "title": "Use it on the page",
          "file": "HostPage.xaml",
          "edit": {
            "op": "insert-after",
            "anchor": "        <TextBlock x:Name=\"HostText\" Text=\"controls\" />",
            "text": "        <local:Badge x:Name=\"FirstBadge\" Label=\"badge one\" />"
          },
          "checkpoint": {
            "id": "k-n2-use-usercontrol",
            "kind": "live",
            "uiChecks": [
              {
                "target": "badge one",
                "assert": "exists"
              }
            ],
            "parity": true
          }
        },
        {
          "id": "n3-edit-usercontrol",
          "title": "Edit the UserControl's markup",
          "file": "Badge.xaml",
          "edit": {
            "op": "replace",
            "find": "        <TextBlock x:Name=\"BadgeText\" Text=\"{x:Bind Label, Mode=OneWay}\" />",
            "text": [
              "        <StackPanel Orientation=\"Horizontal\" Spacing=\"4\">",
              "            <TextBlock x:Name=\"BadgePrefix\" Text=\"badge:\" />",
              "            <TextBlock x:Name=\"BadgeText\" Text=\"{x:Bind Label, Mode=OneWay}\" />",
              "        </StackPanel>"
            ]
          },
          "checkpoint": {
            "id": "k-n3-edit-usercontrol",
            "kind": "live",
            "uiChecks": [
              {
                "target": "badge:",
                "assert": "exists"
              },
              {
                "target": "badge one",
                "assert": "exists"
              }
            ]
          }
        },
        {
          "id": "n4-add-templated",
          "title": "Add a templated control with Themes\\Generic.xaml",
          "edits": [
            {
              "file": "Chip.cs",
              "edit": {
                "op": "create-file",
                "text": [
                  "using Microsoft.UI.Xaml;",
                  "using Microsoft.UI.Xaml.Controls;",
                  "",
                  "namespace TodoBench;",
                  "",
                  "public sealed partial class Chip : Control",
                  "{",
                  "    public static readonly DependencyProperty TextProperty =",
                  "        DependencyProperty.Register(nameof(Text), typeof(string), typeof(Chip), new PropertyMetadata(\"\"));",
                  "",
                  "    public Chip()",
                  "    {",
                  "        DefaultStyleKey = typeof(Chip);",
                  "    }",
                  "",
                  "    public string Text",
                  "    {",
                  "        get => (string)GetValue(TextProperty);",
                  "        set => SetValue(TextProperty, value);",
                  "    }",
                  "}"
                ]
              }
            },
            {
              "file": "Themes\\Generic.xaml",
              "edit": {
                "op": "create-file",
                "text": [
                  "<ResourceDictionary",
                  "    xmlns=\"http://schemas.microsoft.com/winfx/2006/xaml/presentation\"",
                  "    xmlns:x=\"http://schemas.microsoft.com/winfx/2006/xaml\"",
                  "    xmlns:local=\"using:TodoBench\">",
                  "    <Style TargetType=\"local:Chip\">",
                  "        <Setter Property=\"Template\">",
                  "            <Setter.Value>",
                  "                <ControlTemplate TargetType=\"local:Chip\">",
                  "                    <Border Padding=\"6\" CornerRadius=\"8\" BorderThickness=\"1\" BorderBrush=\"Gray\">",
                  "                        <TextBlock Text=\"{TemplateBinding Text}\" />",
                  "                    </Border>",
                  "                </ControlTemplate>",
                  "            </Setter.Value>",
                  "        </Setter>",
                  "    </Style>",
                  "</ResourceDictionary>"
                ]
              }
            }
          ],
          "checkpoint": {
            "id": "k-n4-add-templated",
            "kind": "live",
            "uiChecks": [
              {
                "target": "badge one",
                "assert": "exists"
              }
            ]
          }
        },
        {
          "id": "n5-use-templated",
          "title": "Use it on the page",
          "file": "HostPage.xaml",
          "edit": {
            "op": "insert-after",
            "anchor": "        <local:Badge x:Name=\"FirstBadge\" Label=\"badge one\" />",
            "text": "        <local:Chip x:Name=\"FirstChip\" Text=\"chip one\" />"
          },
          "checkpoint": {
            "id": "k-n5-use-templated",
            "kind": "live",
            "uiChecks": [
              {
                "target": "chip one",
                "assert": "exists"
              }
            ],
            "parity": true
          }
        },
        {
          "id": "n6-edit-template",
          "title": "Edit the control's template in Generic.xaml",
          "file": "Themes\\Generic.xaml",
          "edit": {
            "op": "replace",
            "find": "                        <TextBlock Text=\"{TemplateBinding Text}\" />",
            "text": [
              "                        <StackPanel Orientation=\"Horizontal\" Spacing=\"4\">",
              "                            <TextBlock Text=\"tag:\" />",
              "                            <TextBlock Text=\"{TemplateBinding Text}\" />",
              "                        </StackPanel>"
            ]
          },
          "checkpoint": {
            "id": "k-n6-edit-template",
            "kind": "live",
            "uiChecks": [
              {
                "target": "tag:",
                "assert": "exists"
              },
              {
                "target": "chip one",
                "assert": "exists"
              }
            ]
          }
        }
      ]
    }
  ]
}
