{
  "schemaVersion": "1.0",
  "id": "sb-hour-of-edits",
  "title": "Scoreboard: the edits a developer makes in an hour, on a contacts page",
  "description": [
    "A contacts page (a list with a DataTemplate, a detail panel, a view model). Nineteen saves: rename and insert",
    "elements, a new Click handler, an x:Name used from code, x:Bind added, changed and removed, the DataTemplate edited",
    "and its x:DataType changed, a deferred x:Load panel, a page resource and a style added and changed, an element",
    "deleted, a new method. Every save checks the UI; the parity gate runs at the x:Bind, template and x:Load steps."
  ],
  "app": {
    "template": "app-template",
    "assetsFrom": "samples/winui-app/Assets",
    "projectFile": "TodoBench.csproj",
    "rootNamespace": "TodoBench"
  },
  "parity": {
    "auto": true,
    "root": "ContactsPage",
    "prepare": [
      {
        "target": "ResetButton",
        "assert": "invoke"
      }
    ],
    "probes": [
      {
        "target": "FirstButton",
        "assert": "invoke"
      }
    ]
  },
  "dimensions": [],
