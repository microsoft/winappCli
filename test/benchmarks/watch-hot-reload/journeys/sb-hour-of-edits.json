      }
    },
    {
      "id": "setup-MainWindow-xaml-cs",
      "file": "MainWindow.xaml.cs",
      "edit": {
        "op": "create-file",
        "text": [
          "using Microsoft.UI.Xaml;",
          "",
          "namespace TodoBench;",
          "",
          "public sealed partial class MainWindow : Window",
          "{",
          "    public MainWindow()",
          "    {",
          "        InitializeComponent();",
          "        Nav.Navigate(typeof(ContactsPage));",
          "    }",
          "}"
        ]
      }
    },
    {
      "id": "setup-Models-cs",
      "file": "Models.cs",
      "edit": {
        "op": "create-file",
        "text": [
          "using System.Collections.ObjectModel;",
          "using System.ComponentModel;",
          "using System.Runtime.CompilerServices;",
          "",
          "namespace TodoBench;",
          "",
          "public partial class Person",
          "{",
          "    public string Name { get; set; } = \"\";",
          "}",
          "",
          "public sealed partial class Contact : Person",
          "{",
          "    public string Email { get; set; } = \"\";",
          "}",
          "",
          "public sealed partial class ContactsVm : INotifyPropertyChanged",
          "{",
          "    private Contact? _selected;",
          "    private string _title = \"Team\";",
          "    private bool _showDetails;",
          "    private int _added;",
          "",
          "    public event PropertyChangedEventHandler? PropertyChanged;",
          "",
          "    public ObservableCollection<Contact> Contacts { get; } = [];",
          "    public Contact? Selected { get => _selected; set { _selected = value; Raise(); } }",
          "    public string Title { get => _title; set { _title = value; Raise(); } }",
          "    public bool ShowDetails { get => _showDetails; set { _showDetails = value; Raise(); } }",
          "",
          "    public ContactsVm() => Reset();",
          "",
          "    public void Reset()",
          "    {",
          "        Contacts.Clear();",
          "        foreach (var name in new[] { \"Ada\", \"Grace\", \"Linus\" })",
          "        {",
          "            Contacts.Add(new Contact { Name = name, Email = $\"{name.ToLowerInvariant()}@contoso.com\" });",
          "        }",
          "        _added = 0;",
          "        Selected = null;",
          "        Title = \"Team\";",
          "        ShowDetails = false;",
          "    }",
          "",
          "    public void Add() => Contacts.Add(new Contact { Name = $\"New {++_added}\", Email = \"new@contoso.com\" });",
          "",
          "    private void Raise([CallerMemberName] string? name = null) => PropertyChanged?.Invoke(this, new PropertyChangedEventArgs(name));",
          "}"
        ]
      }
    },
    {
      "id": "setup-ContactsPage-xaml",
      "file": "ContactsPage.xaml",
      "edit": {
        "op": "create-file",
        "text": [
          "<?xml version=\"1.0\" encoding=\"utf-8\" ?>",
          "<Page",
          "    x:Class=\"TodoBench.ContactsPage\"",
          "    xmlns=\"http://schemas.microsoft.com/winfx/2006/xaml/presentation\"",
          "    xmlns:x=\"http://schemas.microsoft.com/winfx/2006/xaml\"",
          "    xmlns:local=\"using:TodoBench\">",
          "    <Grid x:Name=\"Root\" Padding=\"12\" RowSpacing=\"8\" ColumnSpacing=\"12\">",
          "        <Grid.RowDefinitions>",
          "            <RowDefinition Height=\"Auto\" />",
          "            <RowDefinition Height=\"*\" />",
          "        </Grid.RowDefinitions>",
          "        <Grid.ColumnDefinitions>",
          "            <ColumnDefinition Width=\"260\" />",
          "            <ColumnDefinition Width=\"*\" />",
          "        </Grid.ColumnDefinitions>",
          "        <StackPanel x:Name=\"HeaderPanel\" Grid.ColumnSpan=\"2\" Orientation=\"Horizontal\" Spacing=\"8\">",
          "            <TextBlock x:Name=\"Header\" Text=\"Contacts\" FontSize=\"24\" />",
          "            <Button x:Name=\"AddButton\" Content=\"Add\" Click=\"OnAdd\" />",
          "            <Button x:Name=\"ResetButton\" Content=\"Reset\" Click=\"OnReset\" />",
          "        </StackPanel>",
          "        <ListView x:Name=\"ContactList\" Grid.Row=\"1\" ItemsSource=\"{x:Bind Vm.Contacts}\" SelectionChanged=\"OnSelectionChanged\">",
          "            <ListView.ItemTemplate>",
          "                <DataTemplate x:DataType=\"local:Contact\">",
          "                    <TextBlock Text=\"{x:Bind Name}\" />",
          "                </DataTemplate>",
          "            </ListView.ItemTemplate>",
          "        </ListView>",
          "        <StackPanel x:Name=\"DetailPanel\" Grid.Row=\"1\" Grid.Column=\"1\" Spacing=\"4\">",
          "            <TextBlock x:Name=\"DetailName\" Text=\"{x:Bind Vm.Selected.Name, Mode=OneWay, FallbackValue='(none)'}\" />",
          "        </StackPanel>",
          "    </Grid>",
          "</Page>"
        ]
      }
    },
    {
      "id": "setup-ContactsPage-xaml-cs",
      "file": "ContactsPage.xaml.cs",
      "edit": {
        "op": "create-file",
        "text": [
          "using Microsoft.UI.Xaml;",
          "using Microsoft.UI.Xaml.Controls;",
          "",
          "namespace TodoBench;",
          "",
          "public sealed partial class ContactsPage : Page",
          "{",
          "    public ContactsVm Vm { get; } = new();",
          "",
          "    public ContactsPage()",
          "    {",
          "        InitializeComponent();",
          "    }",
          "",
          "    private void OnAdd(object sender, RoutedEventArgs e)",
          "    {",
          "        Vm.Add();",
          "    }",
          "",
          "    private void OnReset(object sender, RoutedEventArgs e)",
          "    {",
          "        Vm.Reset();",
          "        ContactList.SelectedIndex = -1;",
          "        if (FindName(\"StatusText\") is TextBlock status)",
          "        {",
          "            status.Text = \"ready\";",
          "        }",
          "    }",
          "",
          "    private void OnSelectionChanged(object sender, SelectionChangedEventArgs e)",
          "    {",
          "        Vm.Selected = ContactList.SelectedItem as Contact;",
          "    }",
          "}"
        ]
      }
    }
  ],
