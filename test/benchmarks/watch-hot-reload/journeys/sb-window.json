{
  "schemaVersion": "1.0",
  "id": "sb-window",
  "title": "Scoreboard: edits to MainWindow itself",
  "description": [
    "The window, not a page: text, a new Click handler, an x:Bind, a code edit and the Title. A window can't be",
    "navigated away and re-created like a page, so it shows what each approach does with the root of the app."
  ],
  "app": {
    "template": "app-template",
    "assetsFrom": "samples/winui-app/Assets",
    "projectFile": "TodoBench.csproj",
    "rootNamespace": "TodoBench"
  },
  "parity": {
    "auto": true,
    "ignore": [
      "*#WinResult.Text"
    ]
  },
  "dimensions": [],
  "variants": [
    {
      "id": "default",
      "primary": true,
      "summary": "The only ordering.",
      "choices": {}
    }
  ],
  "setup": [
    {
      "id": "setup-MainWindow-xaml",
      "file": "MainWindow.xaml",
      "edit": {
        "op": "create-file",
        "text": [
          "<?xml version=\"1.0\" encoding=\"utf-8\" ?>",
          "<Window",
          "    x:Class=\"TodoBench.MainWindow\"",
          "    xmlns=\"http://schemas.microsoft.com/winfx/2006/xaml/presentation\"",
          "    xmlns:x=\"http://schemas.microsoft.com/winfx/2006/xaml\"",
          "    xmlns:local=\"using:TodoBench\"",
          "    Title=\"TodoBench\">",
          "    <StackPanel x:Name=\"Root\" Padding=\"16\" Spacing=\"8\">",
          "        <TextBlock x:Name=\"WinHeading\" Text=\"window v1\" />",
          "        <TextBox x:Name=\"WinBox\" />",
          "        <TextBlock x:Name=\"WinResult\" Text=\"\" />",
          "    </StackPanel>",
          "</Window>"
        ]
      }
    },
    {
      "id": "setup-MainWindow-xaml-cs",
      "file": "MainWindow.xaml.cs",
      "edit": {
        "op": "create-file",
        "text": [
          "using Microsoft.UI.Xaml;",
          "",
          "namespace TodoBench;",
          "",
          "public sealed partial class MainWindow : Window",
          "{",
          "    private int _clicks;",
          "",
          "    public MainWindow()",
          "    {",
          "        InitializeComponent();",
          "    }",
          "",
          "    public string Greeting => \"hello window\";",
          "}"
        ]
      }
    }
  ],
  "segments": [
    {
      "kind": "common",
      "phase": "scoreboard",
      "title": "Scoreboard: edits to MainWindow itself",
      "actions": [
        {
          "id": "w1-text",
          "title": "Change the window's text, then the user types",
          "file": "MainWindow.xaml",
          "edit": {
            "op": "replace",
            "find": "Text=\"window v1\"",
            "text": "Text=\"window v2\""
          },
          "checkpoint": {
            "id": "k-w1-text",
            "kind": "live",
            "uiChecks": [
              {
                "target": "WinHeading",
                "assert": "text-equals",
                "value": "window v2"
              },
              {
                "target": "WinBox",
                "assert": "set-value",
                "value": "typed in window"
              }
            ]
          }
        },
        {
          "id": "w2-click-handler",
          "title": "A button and its Click handler in the window",
          "edits": [
            {
              "file": "MainWindow.xaml",
              "edit": {
                "op": "insert-after",
                "anchor": "        <TextBox x:Name=\"WinBox\" />",
                "text": "        <Button x:Name=\"WinButton\" Content=\"Click\" Click=\"OnWinClick\" />"
              }
            },
            {
              "file": "MainWindow.xaml.cs",
              "edit": {
                "op": "insert-before",
                "anchor": "    public string Greeting",
                "text": [
                  "    private void OnWinClick(object sender, RoutedEventArgs e)",
                  "    {",
                  "        _clicks++;",
                  "        WinResult.Text = $\"window clicks: {_clicks}\";",
                  "    }",
                  ""
                ]
              }
            }
          ],
          "checkpoint": {
            "id": "k-w2-click-handler",
            "kind": "live",
            "uiChecks": [
              {
                "target": "WinButton",
                "assert": "invoke"
              },
              {
                "target": "WinResult",
                "assert": "text-equals",
                "value": "window clicks: 1"
              },
              {
                "target": "WinBox",
                "assert": "text-equals",
                "value": "typed in window",
                "state": "typed text (window)"
              }
            ]
          }
        },
        {
          "id": "w3-xbind",
          "title": "An x:Bind in the window",
          "file": "MainWindow.xaml",
          "edit": {
            "op": "insert-after",
            "anchor": "        <TextBlock x:Name=\"WinHeading\" Text=\"window v2\" />",
            "text": "        <TextBlock x:Name=\"WinBound\" Text=\"{x:Bind Greeting}\" />"
          },
          "checkpoint": {
            "id": "k-w3-xbind",
            "kind": "live",
            "uiChecks": [
              {
                "target": "WinBound",
                "assert": "text-equals",
                "value": "hello window"
              },
              {
                "target": "WinBox",
                "assert": "text-equals",
                "value": "typed in window",
                "state": "typed text (window)"
              },
              {
                "target": "WinButton",
                "assert": "invoke"
              },
              {
                "target": "WinResult",
                "assert": "number-increased",
                "state": "window field"
              }
            ],
            "parity": true
          }
        },
        {
          "id": "w4-code",
          "title": "Change the handler's text",
          "file": "MainWindow.xaml.cs",
          "edit": {
            "op": "replace",
            "find": "$\"window clicks: {_clicks}\"",
            "text": "$\"clicks now: {_clicks}\""
          },
          "checkpoint": {
            "id": "k-w4-code",
            "kind": "live",
            "uiChecks": [
              {
                "target": "WinButton",
                "assert": "invoke"
              },
              {
                "target": "WinResult",
                "assert": "text-contains",
                "value": "clicks now:"
              },
              {
                "target": "WinBox",
                "assert": "text-equals",
                "value": "typed in window",
                "state": "typed text (window)"
              }
            ]
          }
        },
        {
          "id": "w5-title",
          "title": "Change the window's Title",
          "file": "MainWindow.xaml",
          "edit": {
            "op": "replace",
            "find": "    Title=\"TodoBench\">",
            "text": "    Title=\"TodoBench window\">"
          },
          "checkpoint": {
            "id": "k-w5-title",
            "kind": "live",
            "uiChecks": [
              {
                "target": "WinHeading",
                "assert": "text-equals",
                "value": "window v2"
              },
              {
                "target": "WinBox",
                "assert": "text-equals",
                "value": "typed in window",
                "state": "typed text (window)"
              }
            ]
          }
        }
      ]
    }
  ]
}
