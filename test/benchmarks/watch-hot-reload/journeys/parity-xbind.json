{
  "schemaVersion": "1.0",
  "id": "parity-xbind",
  "desktop": "exclusive",
  "title": "Parity gate: x:Bind shapes hot reload applies exactly as a clean build does",
  "description": [
    "Adds a page's x:Bind shapes in one save, then edits it again. After each, the parity gate compares the hot-reloaded",
    "page with a clean build of the same source: the visual tree, the values shown, which bindings follow the view model",
    "(Set changes it), that Bindings.Update() re-evaluates one-time bindings (Refresh), that a two-way box writes back when",
    "focus leaves it (type, leave), and that Click handlers are wired. Every shape here behaves the same both ways; a",
    "difference fails the journey."
  ],
  "app": {
    "template": "app-template",
    "assetsFrom": "samples/winui-app/Assets",
    "projectFile": "TodoBench.csproj",
    "rootNamespace": "TodoBench"
  },
  "parity": {
    "auto": true,
    "root": "BindPage",
    "probes": [
      {
        "id": "set",
        "target": "SetButton",
        "assert": "invoke"
      },
      {
        "id": "refresh",
        "target": "RefreshButton",
        "assert": "invoke"
      },
      {
        "id": "type",
        "target": "TitleBox",
        "assert": "set-value",
        "value": "typed"
      },
      {
        "id": "leave",
        "target": "SetButton",
        "assert": "focus"
      },
      {
        "id": "reset",
        "target": "ResetButton",
        "assert": "invoke"
      }
    ]
  },
  "dimensions": [],
  "variants": [
    {
      "id": "default",
      "primary": true,
      "summary": "The only ordering.",
      "choices": {}
    }
  ],
  "setup": [
    {
      "id": "setup-models",
      "file": "Models.cs",
      "edit": {
        "op": "create-file",
        "text": [
          "using System.ComponentModel;",
          "using System.Runtime.CompilerServices;",
          "",
          "namespace TodoBench;",
          "",
          "public sealed partial class BindVm : INotifyPropertyChanged",
          "{",
          "    private string _title = \"start\";",
          "    private int _count = 1;",
          "    private bool _flag;",
          "    public event PropertyChangedEventHandler? PropertyChanged;",
          "    public string Title { get => _title; set { _title = value; Raise(); } }",
          "    public int Count { get => _count; set { _count = value; Raise(); } }",
          "    public bool Flag { get => _flag; set { _flag = value; Raise(); } }",
          "    public string? Nothing => null;",
          "    public BindVm? Missing => null;",
          "    private void Raise([CallerMemberName] string? name = null) => PropertyChanged?.Invoke(this, new PropertyChangedEventArgs(name));",
          "}",
          "",
          "public sealed partial class Item",
          "{",
          "    public string Name { get; set; } = \"item\";",
          "    public bool Shown { get; set; }",
          "    public Item? Inner { get; set; }",
          "    public string Code = \"field\";",
          "}",
          "",
          "public static class Fmt",
          "{",
          "    public static string Upper(string value) => value.ToUpperInvariant();",
          "}"
        ]
      }
    },
    {
      "id": "setup-page-xaml",
      "file": "BindPage.xaml",
      "edit": {
        "op": "create-file",
        "text": [
          "<?xml version=\"1.0\" encoding=\"utf-8\" ?>",
          "<Page",
          "    x:Class=\"TodoBench.BindPage\"",
          "    xmlns=\"http://schemas.microsoft.com/winfx/2006/xaml/presentation\"",
          "    xmlns:x=\"http://schemas.microsoft.com/winfx/2006/xaml\"",
          "    xmlns:local=\"using:TodoBench\">",
          "    <StackPanel x:Name=\"Root\" Padding=\"12\" Spacing=\"4\">",
          "        <TextBlock x:Name=\"Heading\" Text=\"{x:Bind Vm.Title}\" />",
          "    </StackPanel>",
          "</Page>"
        ]
      }
    },
    {
      "id": "setup-page-cs",
      "file": "BindPage.xaml.cs",
      "edit": {
        "op": "create-file",
        "text": [
          "using System.Collections.Generic;",
          "using Microsoft.UI.Xaml;",
          "using Microsoft.UI.Xaml.Controls;",
          "",
          "namespace TodoBench;",
          "",
          "public sealed partial class BindPage : Page",
          "{",
          "    public BindVm Vm { get; } = new();",
          "    public string Late { get; set; } = \"ctor\";",
          "    public List<Item> Items { get; } = [new Item { Name = \"item\", Inner = new Item { Name = \"inner\" } }];",
          "",
          "    public BindPage()",
          "    {",
          "        InitializeComponent();",
          "        Loaded += (_, _) => Late = \"loaded\";",
          "    }",
          "",
          "    private void OnSet(object sender, RoutedEventArgs e)",
          "    {",
          "        Vm.Title = \"set\";",
          "        Vm.Count = 2;",
          "        Vm.Flag = true;",
          "    }",
          "",
          "    private void OnRefresh(object sender, RoutedEventArgs e) => Bindings.Update();",
          "",
          "    private void OnReset(object sender, RoutedEventArgs e)",
          "    {",
          "        Vm.Title = \"start\";",
          "        Vm.Count = 1;",
          "        Vm.Flag = false;",
          "    }",
          "}"
        ]
      }
    },
    {
      "id": "setup-host",
      "file": "MainWindow.xaml",
      "edit": {
        "op": "replace",
        "find": [
          "        <TextBlock",
          "            x:Name=\"StartHere\"",
          "            Margin=\"24\"",
          "            Text=\"Nothing here yet.\" />"
        ],
        "text": [
          "        <Frame x:Name=\"PageFrame\" />"
        ]
      }
    },
    {
      "id": "setup-navigate",
      "file": "MainWindow.xaml.cs",
      "edit": {
        "op": "insert-after",
        "anchor": [
          "        InitializeComponent();"
        ],
        "text": [
          "        PageFrame.Navigate(typeof(BindPage));"
        ]
      }
    }
  ],
  "segments": [
    {
      "kind": "common",
      "phase": "parity",
      "title": "x:Bind shapes that match a clean build",
      "actions": [
        {
          "id": "p1-add-bindings",
          "title": "Add one-time, one-way, two-way, function, null/fallback and template x:Bind, and Click handlers",
          "file": "BindPage.xaml",
          "edit": {
            "op": "replace",
            "find": [
              "        <TextBlock x:Name=\"Heading\" Text=\"{x:Bind Vm.Title}\" />"
            ],
            "text": [
              "        <TextBlock x:Name=\"Heading\" Text=\"{x:Bind Vm.Title}\" />",
              "        <Button x:Name=\"SetButton\" Content=\"Set\" Click=\"OnSet\" />",
              "        <Button x:Name=\"RefreshButton\" Content=\"Refresh\" Click=\"OnRefresh\" />",
              "        <Button x:Name=\"ResetButton\" Content=\"Reset\" Click=\"OnReset\" />",
              "        <TextBox x:Name=\"TitleBox\" Text=\"{x:Bind Vm.Title, Mode=TwoWay}\" />",
              "        <TextBlock x:Name=\"OneWayTitle\" Text=\"{x:Bind Vm.Title, Mode=OneWay}\" />",
              "        <TextBlock x:Name=\"OneWayCount\" Text=\"{x:Bind Vm.Count, Mode=OneWay}\" />",
              "        <TextBlock x:Name=\"NullText\" Text=\"{x:Bind Vm.Nothing, TargetNullValue=none}\" />",
              "        <TextBlock x:Name=\"FallbackText\" Text=\"{x:Bind Vm.Missing.Title, FallbackValue=fallback}\" />",
              "        <CheckBox x:Name=\"FlagBox\" Content=\"Flag\" IsChecked=\"{x:Bind Vm.Flag, Mode=OneWay}\" />",
              "        <TextBlock x:Name=\"FlagShown\" Text=\"shown when flag\" Visibility=\"{x:Bind Vm.Flag, Mode=OneWay}\" />",
              "        <TextBlock x:Name=\"FunctionText\" Text=\"{x:Bind local:Fmt.Upper(Vm.Title), Mode=OneWay}\" />",
              "        <ListView x:Name=\"ItemList\" ItemsSource=\"{x:Bind Items}\">",
              "            <ListView.ItemTemplate>",
              "                <DataTemplate x:DataType=\"local:Item\">",
              "                    <StackPanel>",
              "                        <TextBlock Text=\"{x:Bind Name}\" />",
              "                        <TextBlock Text=\"collapsed unless Shown\" Visibility=\"{x:Bind Shown}\" />",
              "                    </StackPanel>",
              "                </DataTemplate>",
              "            </ListView.ItemTemplate>",
              "        </ListView>"
            ]
          },
          "checkpoint": {
            "id": "k1-bindings-match",
            "kind": "parity",
            "parity": true,
            "runtimeState": "Every reading of the page (on load, after Set, Refresh, typing, leaving the box and Reset) is the same as a clean build's."
          }
        },
        {
          "id": "p2-edit-again",
          "title": "Restyle the heading and add one more one-way binding",
          "file": "BindPage.xaml",
          "edit": {
            "op": "replace",
            "find": [
              "        <TextBlock x:Name=\"Heading\" Text=\"{x:Bind Vm.Title}\" />"
            ],
            "text": [
              "        <TextBlock x:Name=\"Heading\" Text=\"{x:Bind Vm.Title}\" FontSize=\"20\" />",
              "        <TextBlock x:Name=\"TitleUpper\" Text=\"{x:Bind local:Fmt.Upper(Vm.Title), Mode=OneWay}\" Opacity=\"0.5\" />"
            ]
          },
          "checkpoint": {
            "id": "k2-still-matches",
            "kind": "parity",
            "runtimeState": "After a second reload of the same page (the gate runs after the last save), it still matches."
          }
        }
      ]
    }
  ]
}
