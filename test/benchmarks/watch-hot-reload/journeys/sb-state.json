          "<Window",
          "    x:Class=\"TodoBench.MainWindow\"",
          "    xmlns=\"http://schemas.microsoft.com/winfx/2006/xaml/presentation\"",
          "    xmlns:x=\"http://schemas.microsoft.com/winfx/2006/xaml\"",
          "    xmlns:local=\"using:TodoBench\"",
          "    Title=\"TodoBench\">",
          "    <Frame x:Name=\"Nav\" />",
          "</Window>"
        ]
      }
    },
    {
      "id": "setup-MainWindow-xaml-cs",
      "file": "MainWindow.xaml.cs",
      "edit": {
        "op": "create-file",
        "text": [
          "using Microsoft.UI.Xaml;",
          "",
          "namespace TodoBench;",
          "",
          "public sealed partial class MainWindow : Window",
          "{",
          "    public MainWindow()",
          "    {",
          "        InitializeComponent();",
          "        Nav.Navigate(typeof(HomePage));",
          "        Nav.Navigate(typeof(DetailPage));",
          "        Nav.Navigate(typeof(StatePage), \"from-main\");",
          "    }",
