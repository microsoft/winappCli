{
  "schemaVersion": "1.0",
  "id": "sb-state",
  "title": "Scoreboard: what the user and the page built up, and what survives a save",
  "description": [
    "The page is three deep in a Frame (Home, Detail, State, with a navigation parameter). The user types, checks a box,",
    "selects an item, scrolls, and clicks counters held in a page field and in a page-owned view model; the page loads",
    "its list in OnNavigatedTo. Then come an unrelated XAML save, an unrelated C# save, a structural XAML save and a",
    "XAML+C# save. After each, every check marked \"state\" asks whether that piece survived. Counters are checked",
    "relative to before the save. The parity gate is off: this state is what a clean launch cannot have."
  ],
  "app": {
    "template": "app-template",
    "assetsFrom": "samples/winui-app/Assets",
    "projectFile": "TodoBench.csproj",
    "rootNamespace": "TodoBench"
  },
  "parity": {
    "enabled": false
  },
  "dimensions": [],
  "variants": [
    {
      "id": "default",
      "primary": true,
      "summary": "The only ordering.",
      "choices": {}
    }
  ],
