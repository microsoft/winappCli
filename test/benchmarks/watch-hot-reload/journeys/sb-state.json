    {
      "id": "setup-StatePage-xaml",
      "file": "StatePage.xaml",
      "edit": {
        "op": "create-file",
        "text": [
          "<?xml version=\"1.0\" encoding=\"utf-8\" ?>",
          "<Page",
          "    x:Class=\"TodoBench.StatePage\"",
          "    xmlns=\"http://schemas.microsoft.com/winfx/2006/xaml/presentation\"",
          "    xmlns:x=\"http://schemas.microsoft.com/winfx/2006/xaml\"",
          "    xmlns:local=\"using:TodoBench\">",
          "    <StackPanel x:Name=\"Root\" Padding=\"12\" Spacing=\"6\">",
          "        <TextBlock x:Name=\"Heading\" Text=\"State v1\" />",
          "        <TextBlock x:Name=\"ParamText\" Text=\"(no parameter)\" />",
          "        <TextBox x:Name=\"TypedBox\" />",
          "        <CheckBox x:Name=\"KeptBox\" Content=\"Remember me\" />",
          "        <StackPanel Orientation=\"Horizontal\" Spacing=\"6\">",
          "            <Button x:Name=\"ClickButton\" Content=\"Count\" Click=\"OnCount\" />",
          "            <TextBlock x:Name=\"ClickText\" Text=\"clicks: 0\" />",
          "        </StackPanel>",
          "        <StackPanel Orientation=\"Horizontal\" Spacing=\"6\">",
          "            <Button x:Name=\"BumpButton\" Content=\"Bump\" Click=\"OnBump\" />",
          "            <TextBlock x:Name=\"VmText\" Text=\"{x:Bind Vm.Label, Mode=OneWay}\" />",
          "        </StackPanel>",
          "        <ListView x:Name=\"Picker\" Height=\"120\" SelectionMode=\"Single\" />",
          "        <ScrollViewer x:Name=\"Scroller\" Height=\"80\">",
          "            <StackPanel x:Name=\"ScrollContent\" />",
          "        </ScrollViewer>",
          "        <Button x:Name=\"BackButton\" Content=\"Back\" Click=\"OnBack\" />",
          "    </StackPanel>",
          "</Page>"
        ]
      }
    },
    {
      "id": "setup-StatePage-xaml-cs",
      "file": "StatePage.xaml.cs",
      "edit": {
        "op": "create-file",
        "text": [
          "using System.Collections.Generic;",
          "using System.ComponentModel;",
          "using Microsoft.UI.Xaml;",
          "using Microsoft.UI.Xaml.Controls;",
          "using Microsoft.UI.Xaml.Navigation;",
          "",
          "namespace TodoBench;",
          "",
          "public sealed partial class StateVm : INotifyPropertyChanged",
          "{",
          "    private int _bumps;",
          "    public event PropertyChangedEventHandler? PropertyChanged;",
          "    public string Label => $\"vm bumps: {_bumps}\";",
          "    public void Bump()",
          "    {",
          "        _bumps++;",
          "        PropertyChanged?.Invoke(this, new PropertyChangedEventArgs(nameof(Label)));",
          "    }",
          "}",
          "",
          "public sealed partial class StatePage : Page",
          "{",
          "    private int _clicks;",
          "",
          "    public StateVm Vm { get; } = new();",
          "",
          "    public StatePage()",
          "    {",
          "        InitializeComponent();",
          "        for (var i = 0; i < 30; i++)",
          "        {",
          "            ScrollContent.Children.Add(new TextBlock { Text = $\"line {i}\" });",
          "        }",
          "    }",
          "",
          "    protected override void OnNavigatedTo(NavigationEventArgs e)",
          "    {",
          "        base.OnNavigatedTo(e);",
          "        ParamText.Text = $\"param: {e.Parameter}\";",
          "        Picker.ItemsSource = new List<string> { \"Apple\", \"Banana\", \"Cherry\", \"Date\", \"Elder\" };",
          "    }",
          "",
          "    private void OnCount(object sender, RoutedEventArgs e)",
          "    {",
          "        _clicks++;",
          "        ClickText.Text = $\"clicks: {_clicks}\";",
          "    }",
          "",
          "    private void OnBump(object sender, RoutedEventArgs e) => Vm.Bump();",
          "",
          "    private void OnBack(object sender, RoutedEventArgs e)",
          "    {",
          "        if (Frame.CanGoBack)",
          "        {",
          "            Frame.GoBack();",
          "        }",
          "    }",
          "}"
        ]
      }
    }
  ],
