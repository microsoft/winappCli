{
  "schemaVersion": "1.0",
  "id": "sb-d2-template-field",
  "title": "Scoreboard: A template x:Bind to a public field, as the first save after launch",
  "description": [
    "One divergent x:Bind shape from parity-xbind-divergences, saved alone into the freshly launched page and compared with a clean build.",
    "Compiled x:Bind reads fields. The {Binding Code} hot reload rewrites it to reads only properties, so the text is empty."
  ],
  "app": {
    "template": "app-template",
    "assetsFrom": "samples/winui-app/Assets",
    "projectFile": "TodoBench.csproj",
    "rootNamespace": "TodoBench"
  },
  "parity": {
    "auto": true,
    "root": "BindPage",
    "probes": [
      {
        "id": "set",
        "target": "SetButton",
        "assert": "invoke"
      },
      {
        "id": "reset",
        "target": "ResetButton",
        "assert": "invoke"
      }
    ]
  },
  "dimensions": [],
  "variants": [
    {
      "id": "default",
      "primary": true,
      "summary": "The only ordering.",
      "choices": {}
    }
  ],
  "setup": [
    {
      "id": "setup-models",
      "file": "Models.cs",
      "edit": {
        "op": "create-file",
        "text": [
          "using System.ComponentModel;",
          "using System.Runtime.CompilerServices;",
          "",
          "namespace TodoBench;",
          "",
          "public sealed partial class BindVm : INotifyPropertyChanged",
          "{",
          "    private string _title = \"start\";",
          "    private int _count = 1;",
          "    private bool _flag;",
          "    public event PropertyChangedEventHandler? PropertyChanged;",
          "    public string Title { get => _title; set { _title = value; Raise(); } }",
          "    public int Count { get => _count; set { _count = value; Raise(); } }",
          "    public bool Flag { get => _flag; set { _flag = value; Raise(); } }",
          "    public string? Nothing => null;",
          "    public BindVm? Missing => null;",
          "    private void Raise([CallerMemberName] string? name = null) => PropertyChanged?.Invoke(this, new PropertyChangedEventArgs(name));",
          "}",
          "",
          "public sealed partial class Item",
          "{",
          "    public string Name { get; set; } = \"item\";",
          "    public bool Shown { get; set; }",
          "    public Item? Inner { get; set; }",
          "    public string Code = \"field\";",
          "}",
          "",
          "public static class Fmt",
          "{",
          "    public static string Upper(string value) => value.ToUpperInvariant();",
          "}"
        ]
      }
    },
    {
      "id": "setup-page-xaml",
      "file": "BindPage.xaml",
      "edit": {
        "op": "create-file",
        "text": [
          "<?xml version=\"1.0\" encoding=\"utf-8\" ?>",
          "<Page",
          "    x:Class=\"TodoBench.BindPage\"",
          "    xmlns=\"http://schemas.microsoft.com/winfx/2006/xaml/presentation\"",
          "    xmlns:x=\"http://schemas.microsoft.com/winfx/2006/xaml\"",
          "    xmlns:local=\"using:TodoBench\">",
          "    <StackPanel x:Name=\"Root\" Padding=\"12\" Spacing=\"4\">",
          "        <TextBlock x:Name=\"Heading\" Text=\"{x:Bind Vm.Title}\" />",
          "        <Button x:Name=\"SetButton\" Content=\"Set\" Click=\"OnSet\" />",
          "        <Button x:Name=\"ResetButton\" Content=\"Reset\" Click=\"OnReset\" />",
          "        <!-- parity case -->",
          "    </StackPanel>",
          "</Page>"
        ]
      }
    },
    {
      "id": "setup-page-cs",
      "file": "BindPage.xaml.cs",
      "edit": {
        "op": "create-file",
        "text": [
          "using System.Collections.Generic;",
          "using Microsoft.UI.Xaml;",
          "using Microsoft.UI.Xaml.Controls;",
          "",
          "namespace TodoBench;",
          "",
          "public sealed partial class BindPage : Page",
          "{",
          "    public BindVm Vm { get; } = new();",
          "    public string Late { get; set; } = \"ctor\";",
          "    public List<Item> Items { get; } = [new Item { Name = \"item\", Inner = new Item { Name = \"inner\" } }];",
          "",
          "    public BindPage()",
          "    {",
          "        InitializeComponent();",
          "        Loaded += (_, _) => Late = \"loaded\";",
          "    }",
          "",
          "    private void OnSet(object sender, RoutedEventArgs e)",
          "    {",
          "        Vm.Title = \"set\";",
          "        Vm.Count = 2;",
          "        Vm.Flag = true;",
          "    }",
          "",
          "    private void OnRefresh(object sender, RoutedEventArgs e) => Bindings.Update();",
          "",
          "    private void OnReset(object sender, RoutedEventArgs e)",
          "    {",
          "        Vm.Title = \"start\";",
          "        Vm.Count = 1;",
          "        Vm.Flag = false;",
          "    }",
          "}"
        ]
      }
    },
    {
      "id": "setup-host",
      "file": "MainWindow.xaml",
      "edit": {
        "op": "replace",
        "find": [
          "        <TextBlock",
          "            x:Name=\"StartHere\"",
          "            Margin=\"24\"",
          "            Text=\"Nothing here yet.\" />"
        ],
        "text": [
          "        <Frame x:Name=\"PageFrame\" />"
        ]
      }
    },
    {
      "id": "setup-navigate",
      "file": "MainWindow.xaml.cs",
      "edit": {
        "op": "insert-after",
        "anchor": [
          "        InitializeComponent();"
        ],
        "text": [
          "        PageFrame.Navigate(typeof(BindPage));"
        ]
      }
    }
  ],
  "segments": [
    {
      "kind": "common",
      "phase": "scoreboard",
      "title": "A template x:Bind to a public field",
      "actions": [
        {
          "id": "d2-template-field",
          "title": "A template x:Bind to a public field",
          "file": "BindPage.xaml",
          "edit": {
            "op": "replace",
            "find": [
              "        <!-- parity case -->"
            ],
            "text": [
              "        <ListView x:Name=\"CaseField\" ItemsSource=\"{x:Bind Items}\">",
              "            <ListView.ItemTemplate>",
              "                <DataTemplate x:DataType=\"local:Item\">",
              "                    <TextBlock Text=\"{x:Bind Code}\" />",
              "                </DataTemplate>",
              "            </ListView.ItemTemplate>",
              "        </ListView>"
            ]
          },
          "checkpoint": {
            "id": "k-d2-template-field",
            "kind": "parity",
            "parity": true,
            "runtimeState": "Compiled x:Bind reads fields. The {Binding Code} hot reload rewrites it to reads only properties, so the text is empty."
          }
        }
      ]
    }
  ]
}
