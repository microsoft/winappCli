  "segments": [
    {
      "kind": "common",
      "phase": "new-types",
      "title": "new types",
      "actions": [
        {
          "id": "n3a-templated-class",
          "title": "New templated control: its class",
          "file": "Pill.cs",
          "edit": {
            "op": "create-file",
            "text": [
              "using Microsoft.UI.Xaml;",
              "using Microsoft.UI.Xaml.Controls;",
              "",
              "namespace TodoBench;",
              "",
              "public sealed class Pill : Control",
              "{",
              "    public static readonly DependencyProperty LabelProperty =",
              "        DependencyProperty.Register(nameof(Label), typeof(string), typeof(Pill), new PropertyMetadata(\"\"));",
              "",
              "    public Pill()",
              "    {",
              "        DefaultStyleKey = typeof(Pill);",
              "    }",
              "",
              "    public string Label",
              "    {",
              "        get => (string)GetValue(LabelProperty);",
              "        set => SetValue(LabelProperty, value);",
              "    }",
              "}"
            ]
          },
          "expect": {
            "outcome": "applied"
          }
        },
        {
          "id": "n3b-generic-xaml",
          "title": "Its default style: a new Themes\\Generic.xaml",
          "file": "Themes\\Generic.xaml",
          "edit": {
            "op": "create-file",
            "text": [
              "<?xml version=\"1.0\" encoding=\"utf-8\" ?>",
              "<ResourceDictionary xmlns=\"http://schemas.microsoft.com/winfx/2006/xaml/presentation\"",
              "    xmlns:x=\"http://schemas.microsoft.com/winfx/2006/xaml\"",
              "    xmlns:local=\"using:TodoBench\">",
              "    <Style TargetType=\"local:Pill\">",
              "        <Setter Property=\"Template\">",
              "            <Setter.Value>",
              "                <ControlTemplate TargetType=\"local:Pill\">",
              "                    <Border Padding=\"6\" CornerRadius=\"12\" BorderThickness=\"1\" BorderBrush=\"Gray\">",
              "                        <StackPanel Orientation=\"Horizontal\" Spacing=\"4\">",
              "                            <TextBlock AutomationProperties.AutomationId=\"PillLabel\" Text=\"{TemplateBinding Label}\" />",
              "                        </StackPanel>",
              "                    </Border>",
              "                </ControlTemplate>",
              "            </Setter.Value>",
              "        </Setter>",
              "    </Style>",
              "</ResourceDictionary>"
            ]
          },
          "expect": {
            "outcome": "applied"
          }
        },
