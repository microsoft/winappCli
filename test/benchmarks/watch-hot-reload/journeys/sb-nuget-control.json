{
  "schemaVersion": "1.0",
  "id": "sb-nuget-control",
  "title": "Scoreboard: a NuGet control (CommunityToolkit SettingsCard) added while the app runs",
  "description": [
    "The project gets a PackageReference to CommunityToolkit.WinUI.Controls.SettingsControls, then the page uses a",
    "SettingsCard from it, then the card is edited. A new package means a new assembly and its XAML metadata provider."
  ],
  "app": {
    "template": "app-template",
    "assetsFrom": "samples/winui-app/Assets",
    "projectFile": "TodoBench.csproj",
    "rootNamespace": "TodoBench"
  },
  "parity": {
    "auto": true,
    "root": "SettingsPage"
  },
  "dimensions": [],
  "variants": [
    {
      "id": "default",
      "primary": true,
      "summary": "The only ordering.",
      "choices": {}
    }
  ],
  "setup": [
    {
      "id": "setup-MainWindow-xaml",
      "file": "MainWindow.xaml",
      "edit": {
        "op": "create-file",
        "text": [
          "<?xml version=\"1.0\" encoding=\"utf-8\" ?>",
          "<Window",
          "    x:Class=\"TodoBench.MainWindow\"",
          "    xmlns=\"http://schemas.microsoft.com/winfx/2006/xaml/presentation\"",
          "    xmlns:x=\"http://schemas.microsoft.com/winfx/2006/xaml\"",
          "    xmlns:local=\"using:TodoBench\"",
          "    Title=\"TodoBench\">",
          "    <Frame x:Name=\"Nav\" />",
          "</Window>"
        ]
      }
    },
    {
      "id": "setup-MainWindow-xaml-cs",
      "file": "MainWindow.xaml.cs",
      "edit": {
        "op": "create-file",
        "text": [
          "using Microsoft.UI.Xaml;",
          "",
          "namespace TodoBench;",
          "",
          "public sealed partial class MainWindow : Window",
          "{",
          "    public MainWindow()",
          "    {",
          "        InitializeComponent();",
          "        Nav.Navigate(typeof(SettingsPage));",
          "    }",
          "}"
        ]
      }
    },
    {
      "id": "setup-SettingsPage-xaml",
      "file": "SettingsPage.xaml",
      "edit": {
        "op": "create-file",
        "text": [
          "<?xml version=\"1.0\" encoding=\"utf-8\" ?>",
          "<Page",
          "    x:Class=\"TodoBench.SettingsPage\"",
          "    xmlns=\"http://schemas.microsoft.com/winfx/2006/xaml/presentation\"",
          "    xmlns:x=\"http://schemas.microsoft.com/winfx/2006/xaml\"",
          "    xmlns:local=\"using:TodoBench\">",
          "    <StackPanel x:Name=\"Root\" Padding=\"12\" Spacing=\"8\">",
          "        <TextBlock x:Name=\"SettingsTitle\" Text=\"Settings\" />",
          "    </StackPanel>",
          "</Page>"
        ]
      }
    },
    {
      "id": "setup-SettingsPage-xaml-cs",
      "file": "SettingsPage.xaml.cs",
      "edit": {
        "op": "create-file",
        "text": [
          "using Microsoft.UI.Xaml.Controls;",
          "",
          "namespace TodoBench;",
          "",
          "public sealed partial class SettingsPage : Page",
          "{",
          "    public SettingsPage()",
          "    {",
          "        InitializeComponent();",
          "    }",
          "}"
        ]
      }
    }
  ],
  "segments": [
    {
      "kind": "common",
      "phase": "scoreboard",
      "title": "Scoreboard: a NuGet control (CommunityToolkit SettingsCard) added while the app runs",
      "actions": [
        {
          "id": "u1-add-package",
          "title": "Add the CommunityToolkit SettingsControls package",
          "file": "TodoBench.csproj",
          "edit": {
            "op": "insert-after",
            "anchor": "    <PackageReference Include=\"Microsoft.WindowsAppSDK\" Version=\"2.3.1\" />",
            "text": "    <PackageReference Include=\"CommunityToolkit.WinUI.Controls.SettingsControls\" Version=\"8.2.251219\" />"
          },
          "checkpoint": {
            "id": "k-u1-add-package",
            "kind": "live",
            "uiChecks": [
              {
                "target": "SettingsTitle",
                "assert": "text-equals",
                "value": "Settings"
              }
            ]
          }
        },
        {
          "id": "u2-use-card",
          "title": "Use a SettingsCard on the page",
          "file": "SettingsPage.xaml",
          "edit": {
            "op": "replace",
            "find": [
              "    xmlns:local=\"using:TodoBench\">",
              "    <StackPanel x:Name=\"Root\" Padding=\"12\" Spacing=\"8\">",
              "        <TextBlock x:Name=\"SettingsTitle\" Text=\"Settings\" />"
            ],
            "text": [
              "    xmlns:local=\"using:TodoBench\"",
              "    xmlns:controls=\"using:CommunityToolkit.WinUI.Controls\">",
              "    <StackPanel x:Name=\"Root\" Padding=\"12\" Spacing=\"8\">",
              "        <TextBlock x:Name=\"SettingsTitle\" Text=\"Settings\" />",
              "        <controls:SettingsCard x:Name=\"SyncCard\" Header=\"Sync\" Description=\"Keep files in sync\">",
              "            <ToggleSwitch x:Name=\"SyncToggle\" />",
              "        </controls:SettingsCard>"
            ]
          },
          "checkpoint": {
            "id": "k-u2-use-card",
            "kind": "live",
            "uiChecks": [
              {
                "target": "Sync",
                "assert": "exists"
              },
              {
                "target": "SyncToggle",
                "assert": "toggle-on"
              }
            ],
            "parity": true
          }
        },
        {
          "id": "u3-edit-card",
          "title": "Change the card's header",
          "file": "SettingsPage.xaml",
          "edit": {
            "op": "replace",
            "find": "Header=\"Sync\"",
            "text": "Header=\"Sync files\""
          },
          "checkpoint": {
            "id": "k-u3-edit-card",
            "kind": "live",
            "uiChecks": [
              {
                "target": "Sync files",
                "assert": "exists"
              },
              {
                "target": "SyncToggle",
                "assert": "toggle-state-equals",
                "value": "On",
                "state": "toggle switch"
              }
            ]
          }
        }
      ]
    }
  ]
}
